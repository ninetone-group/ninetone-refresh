---
import type { SectionTheme } from "../lib/sections";
import { sectionAccent, sectionCta } from "../lib/sections";
import { url as basePathOnly, urlFor } from "../lib/url";
import { hasEnglishVersion, switchHref } from "../lib/i18n";
import type { Lang } from "../lib/translate";
import { sharedT } from "../lib/t";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


interface Props {
  theme?: SectionTheme;
  lang?: Lang;
}

// Default "sv", not "en" (matches Base.astro's corrected fallback — see the
// long comment there): Base.astro always passes an explicit `lang` now, so
// in practice this default only matters for a hypothetical future caller
// that renders Header standalone without going through Base. Swedish is the
// site's actual default locale (decision 1), so a caller-less default
// should match that rather than silently reintroducing the old English-only
// mislabel this section otherwise fixes.
const { theme = "group", lang = "sv" } = Astro.props;
const accent = sectionAccent[theme];
const cta = sectionCta[theme];

// t() bound to this request (docs/i18n-phase-2-brief.md section 4). Reads
// Astro.locals directly rather than taking a `t` prop — see src/lib/t.ts's
// doc comment for why (Astro.locals is shared across every component in one
// render, so this needs no prop threaded through Base → Header). sharedT()
// (not createT() directly) is load-bearing here specifically: Header,
// Footer and CommandPalette are ALL mounted as siblings in Base.astro on
// every single page, and only sharedT() gives them one combined 25-call
// budget for the render instead of 25 each.
const t = sharedT(Astro.locals);

// sectionCta's `sv`/`en` pair PREDATES section 4 and is the kind of
// hardcoded chrome pair decision 5 asks to fold into t() (brief §"Do NOT
// translate" / constraint 3: "if they ARE hardcoded pairs, converting them
// to t() is IN scope ... pick ONE source language"). Picked Swedish as the
// kept source string for every such pair converted in this pass — see the
// PR description for the full reasoning; short version: decision 1 makes sv
// the default/root locale, so keeping sv as source means the 546-page
// static gh build (which never has a live translation call — see
// src/lib/t.ts / translate.ts's no-scheduler-no-API-key degrade path) needs
// NO translation at all to render correctly, since sv IS what's already on
// the page today.
const ctaLabel = await t(cta.sv);

// gh/static target: `/en/` does not exist at all (decision 2 — it's a
// CF-only feature, the middleware that would ever rewrite/detect it is
// entirely HAS_RUNTIME-gated in src/middleware.ts). Rendering a switch that
// links to a URL nothing serves would be a dead link on every one of the
// 546 static preview pages, so the switch is gated the same way every other
// runtime-only affordance in this codebase is (see ContactForm.astro,
// YouTubeFeed.astro): `import.meta.env.PUBLIC_HAS_RUNTIME`.
const hasRuntime =
  import.meta.env.PUBLIC_HAS_RUNTIME === true || import.meta.env.PUBLIC_HAS_RUNTIME === "true";

// Nav labels: same hardcoded-pair substitution as ctaLabel above — Swedish
// kept as the one source string per item, English produced by t(). Two
// items ("Records", "Management") were already identical in both languages
// in the original pairs; those still route through t() for consistency
// (a no-op translation, cheap and correct either way) rather than being
// special-cased out, so this list has exactly one shape to reason about.
const navItemsSource = [
  { href: "/", label: "Hem", match: ["/"] },
  { href: "/records", label: "Records", match: ["/records"] },
  { href: "/management", label: "Management", match: ["/management"] },
  { href: "/ninetone-nation", label: "Nation", match: ["/ninetone-nation"] },
  { href: "/news", label: "Nyheter", match: ["/news"] },
  { href: "/team", label: "Team", match: ["/team"] },
];
// t() is async (translate.ts), so every nav label is resolved here in
// frontmatter — via Promise.all, not inside the template's .map() — before
// the template ever runs. See src/lib/translate.ts's createT() doc comment:
// "t(source)" must be awaited, which a template expression / non-async
// .map() callback cannot do.
const navItems = await Promise.all(
  navItemsSource.map(async (item) => ({ ...item, label: await t(item.label) })),
);

// Chrome strings that don't depend on `theme`/nav data — resolved once,
// up front, same async-in-frontmatter rule as navItems above. sharedT()'s
// memoization (src/lib/t.ts) means "Sök" appearing twice below (button
// aria-label + visible label) costs one translate() call, not two.
const searchLabel = await t("Sök");
const openMenuLabel = await t("Öppna meny");
const menuLabel = await t("Meny");
const closeMenuLabel = await t("Stäng meny");
const mobileNavLabel = await t("Mobilnavigering");

// Strip the configured base so matches work under `/ninetone-refresh-preview`.
const basePrefix = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
const rawPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const pathname = basePrefix && rawPath.startsWith(basePrefix)
  ? rawPath.slice(basePrefix.length) || "/"
  : rawPath;
const isActive = (matches: string[]) =>
  matches.some((m) => (m === "/" ? pathname === "/" : pathname === m || pathname.startsWith(`${m}/`)));

// Language switch target (section 3 deliverable). `pathname` above is
// already base-stripped — on the cf target `base` is "/" so that's a no-op
// and `pathname === Astro.url.pathname`, which is ALSO already
// locale-stripped by src/middleware.ts's rewrite before this component
// ever runs (see src/lib/i18n.ts's `switchHref` doc comment for the full
// reasoning on why the current URL alone can't tell us the current locale
// post-rewrite, and why `lang` — sourced from `locals.lang` via Base.astro
// — is what makes this correct rather than the pathname itself). Passing
// this same `pathname` through `switchHref` costs nothing extra: on gh
// there's no rewrite and no "/en" to strip, so `switchHref` is just
// `localizedPath(pathname, otherLang(lang))` there too.
// THE ONE LINK THAT MUST NOT BE LOCALE-BOUND.
//
// switchHref() already returns the OTHER locale's path — "/records" when the
// visitor is on /en/records, "/en/records" when they're on /records. Passing
// that through the locale-bound url() above re-applied the CURRENT locale on
// top, so on an English page "/records" became "/en/records" and the switch
// pointed at the page you were already on: clicking SV never left English.
// basePathOnly() applies the gh sub-path base and nothing else, which is
// exactly what a fully-formed cross-locale path needs.
const otherHref = basePathOnly(switchHref(pathname, lang));

// Swedish-only pages offer no switch (SEO audit P1 / translations audit P2).
// /integritet and /guider/* pin lang="sv", so the "EN" control would send a
// visitor to a URL that renders Swedish anyway — a promise the page cannot
// keep. Same hasEnglishVersion() rule the hreflang builder and the sitemap
// use, so what the page advertises and what it offers cannot disagree.
const showLanguageSwitch = hasEnglishVersion(pathname);
const otherLangCode = lang === "sv" ? "en" : "sv";

---

<header
  id="site-header"
  data-accent-hex={accent.hex}
  class="sticky top-0 z-40 border-b border-ninetone-rule bg-ninetone-paper/95 text-ninetone-ink backdrop-blur-md transition-[padding,background-color] duration-200"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 transition-[padding] duration-200" id="site-header-inner">
    <a href={url("/")} class="flex shrink-0 items-center gap-3" aria-label="Ninetone Group">
      <img
        src={url("/images/LogoDark.svg")}
        alt="Ninetone Group"
        width={1997}
        height={1208}
        class="h-10 w-auto transition-[height] duration-200"
        id="site-header-logo"
      />
      <span class="hidden font-display text-lg font-medium tracking-tight md:inline">Ninetone Group</span>
    </a>

    <nav class="hidden flex-1 lg:block" aria-label="Primary">
      <ul class="flex items-center justify-center gap-1 text-[0.9375rem]">
        {navItems.map((item) => {
          const active = isActive(item.match);
          return (
            <li>
              <a
                href={url(item.href)}
                class={`relative inline-flex min-h-11 items-center px-3 py-2 font-medium transition-colors hover:text-ninetone-ink ${active ? accent.text : "text-ninetone-ink/65"}`}
                aria-current={active ? "page" : undefined}
              >
                {item.label}
                {active && (
                  <span
                    class={`absolute inset-x-3 -bottom-0.5 h-px ${accent.bg}`}
                    aria-hidden
                  ></span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="search-toggle"
        class="inline-flex h-11 items-center gap-2 rounded-none border border-ninetone-ink/15 px-3 text-sm text-ninetone-ink/70 transition-colors hover:border-ninetone-ink hover:text-ninetone-ink"
        aria-label={searchLabel}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="hidden text-xs font-medium tracking-wide md:inline">{searchLabel}</span>
        <kbd class="hidden rounded border border-ninetone-ink/15 px-1 py-px font-sans text-[0.625rem] font-medium text-ninetone-ink/50 md:inline">⌘K</kbd>
      </button>

      <a
        href={url(cta.href)}
        class={`hidden md:inline-flex min-h-11 items-center gap-2 px-4 py-2 text-sm font-semibold ${accent.cta} transition-colors`}
      >
        {ctaLabel}
        <span aria-hidden>→</span>
      </a>

      {hasRuntime && showLanguageSwitch && (
        <a
          href={otherHref}
          hreflang={otherLangCode}
          lang={otherLangCode}
          class="hidden md:inline-flex min-h-11 min-w-11 items-center justify-center px-2 text-xs font-semibold text-ninetone-ink/65 hover:text-ninetone-ink"
          aria-label={lang === "en" ? "Switch to Swedish" : "Switch to English"}
          data-lang-switch
        >
          {lang === "en" ? "SV" : "EN"}
        </a>
      )}

      <button
        type="button"
        id="mobile-nav-toggle"
        class="inline-flex h-11 w-11 items-center justify-center border border-ninetone-ink/15 text-ninetone-ink transition-colors hover:border-ninetone-ink lg:hidden"
        aria-label={openMenuLabel}
        aria-controls="mobile-nav-panel"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

{/* Mobile nav panel — full-screen overlay, mounted as a header sibling so its
    z-index escapes the sticky <header>'s stacking context (z-40). */}
<div
  id="mobile-nav-panel"
  class="fixed inset-0 z-[60] hidden flex-col bg-ninetone-paper text-ninetone-ink lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={menuLabel}
>
  <div class="flex items-center justify-between border-b border-ninetone-rule px-6 py-4">
    <span class="kicker text-ninetone-ink/55">{menuLabel}</span>
    <button
      type="button"
      id="mobile-nav-close"
      class="inline-flex h-11 w-11 items-center justify-center border border-ninetone-ink/15 text-ninetone-ink transition-colors hover:border-ninetone-ink"
      aria-label={closeMenuLabel}
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="h-5 w-5" aria-hidden="true">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-6 py-10" aria-label={mobileNavLabel}>
    <ul class="flex flex-col gap-1">
      {navItems.map((item) => {
        const active = isActive(item.match);
        return (
          <li>
            <a
              href={url(item.href)}
              class={`group flex items-baseline justify-between gap-4 border-b border-ninetone-rule py-5 font-display text-3xl font-medium leading-tight tracking-tight transition-colors hover:text-ninetone-ink ${active ? accent.text : "text-ninetone-ink"}`}
              aria-current={active ? "page" : undefined}
            >
              <span>{item.label}</span>
              <span class="text-base text-ninetone-ink/40 transition-transform duration-200 group-hover:translate-x-1" aria-hidden>→</span>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mt-10 flex flex-col gap-4">
      <a
        href={url(cta.href)}
        class={`inline-flex min-h-12 items-center justify-between gap-2 px-5 py-3 text-sm font-semibold ${accent.cta} transition-colors`}
      >
        {ctaLabel}
        <span aria-hidden>→</span>
      </a>
      {hasRuntime && showLanguageSwitch && (
        <a
          href={otherHref}
          hreflang={otherLangCode}
          lang={otherLangCode}
          class="kicker self-start text-ninetone-ink/55 hover:text-ninetone-ink"
          data-lang-switch
        >
          {lang === "en" ? "Svenska →" : "English →"}
        </a>
      )}
    </div>
  </nav>
</div>

<script>
  // Client router (2026-09-14): hoisted scripts run ONCE per full load; each
  // client-side navigation swaps the DOM and fires astro:page-load. Element
  // bindings live in initHeader(); the two document/window listeners are
  // registered once and look their elements up at event time.
  const closeMobileNav = () => {
    const navToggle = document.getElementById("mobile-nav-toggle");
    const navPanel = document.getElementById("mobile-nav-panel");
    if (!navPanel) return;
    navPanel.classList.add("hidden");
    navPanel.classList.remove("flex");
    navToggle?.setAttribute("aria-expanded", "false");
    document.body.style.overflow = "";
  };

  function initHeader() {
    document.getElementById("search-toggle")?.addEventListener("click", () => {
      const open = (window as unknown as { ninetoneCmdK?: () => void }).ninetoneCmdK;
      open?.();
    });

    const navToggle = document.getElementById("mobile-nav-toggle");
    const navClose = document.getElementById("mobile-nav-close");
    const navPanel = document.getElementById("mobile-nav-panel");
    if (navToggle && navClose && navPanel) {
      navToggle.addEventListener("click", () => {
        navPanel.classList.remove("hidden");
        navPanel.classList.add("flex");
        navToggle.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      });
      navClose.addEventListener("click", closeMobileNav);
      navPanel.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeMobileNav));
    }

    // A fresh header always renders un-shrunk; re-derive from the scroll position.
    shrunk = false;
    updateShrink();
  }

  let shrunk = false;
  // `snap`: apply the state without the padding/height transition. Used right
  // after a client-side swap, where the router has already laid the new
  // header out at full height, so a plain class flip would animate 77→61 px.
  const updateShrink = (snap = false) => {
    const inner = document.getElementById("site-header-inner");
    const logo = document.getElementById("site-header-logo");
    if (!inner || !logo) return;
    const next = window.scrollY > 24;
    if (next === shrunk) return;
    shrunk = next;
    if (snap) { inner.style.transition = "none"; logo.style.transition = "none"; }
    if (shrunk) {
      inner.classList.replace("py-4", "py-2");
      logo.classList.replace("h-10", "h-8");
    } else {
      inner.classList.replace("py-2", "py-4");
      logo.classList.replace("h-8", "h-10");
    }
    if (snap) {
      void inner.offsetHeight; // commit the snapped state before transitions return
      requestAnimationFrame(() => { inner.style.transition = ""; logo.style.transition = ""; });
    }
  };
  window.addEventListener("scroll", updateShrink, { passive: true });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const navPanel = document.getElementById("mobile-nav-panel");
    if (navPanel && !navPanel.classList.contains("hidden")) closeMobileNav();
  });
  // Scrolled below the shrink threshold, the swapped-in header arrives at
  // full height and would only shrink at astro:page-load — a visible
  // 77→61 px settle on every language switch (measured 2026-09-14).
  // after-swap runs before the new DOM's first paint, so it lands shrunk.
  document.addEventListener("astro:after-swap", () => {
    // Microtask: the router has just scrolled to the top, and the language
    // switch's scroll restore (Base.astro) runs in a later listener of this
    // same event. A microtask lands after both, still before first paint.
    queueMicrotask(() => {
      shrunk = false;
      updateShrink(true);
    });
  });
  document.addEventListener("astro:page-load", initHeader);
</script>
