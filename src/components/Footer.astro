---
import type { SectionTheme } from "../lib/sections";
import { sectionAccent } from "../lib/sections";
import { urlFor } from "../lib/url";
import { sharedT } from "../lib/t";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


interface Props {
  theme?: SectionTheme;
  lang?: "en" | "sv";
}

const { theme = "group" } = Astro.props;
const accent = sectionAccent[theme];

// t() bound to this request — see src/lib/t.ts's doc comment. sharedT(), not
// createT() directly: Footer is mounted as a Header/CommandPalette sibling
// on every page via Base.astro, and only sharedT() gives all three ONE
// combined 25-call render budget instead of 25 each.
const t = sharedT(Astro.locals);

// `ctaCopy`'s sv/en pairs PREDATE section 4 and are exactly the hardcoded
// chrome pairs decision 5 asks to fold into t() (constraint 3: "if they ARE
// hardcoded pairs, converting them to t() is IN scope ... pick ONE source
// language"). Swedish kept as source throughout this file — same choice,
// same reasoning, as Header.astro (decision 1: sv is the default/root
// locale, so the 546-page static gh build needs zero live translation to
// render correctly with sv as source).
const ctaCopySource: Record<SectionTheme, { title: string; body: string; cta: string; href: string }> = {
  group: { title: "Vi vill ha dina demos.", body: "Skicka in din musik så lyssnar vi. Vi söker alltid nästa röst.", cta: "Skicka demo", href: "/records/contact-records" },
  records: { title: "Vi vill ha dina demos.", body: "Skicka in din musik så lyssnar vi. Vi söker alltid nästa röst.", cta: "Skicka demo", href: "/records/contact-records" },
  management: { title: "Vi lyckas tillsammans.", body: "Bygger du en seriös karriär inom social och underhållning? Hör av dig.", cta: "Kontakta oss", href: "/management/contact-management" },
  nation: { title: "Boka ditt nästa ögonblick.", body: "Sveriges främsta artister och underhållare, redo för ditt event.", cta: "Bokningsförfrågan", href: "/ninetone-nation/contact-ninetone-nation" },
};

const copySource = ctaCopySource[theme];
// Resolved in frontmatter (t() is async — src/lib/translate.ts), not inside
// the template, per constraint 2.
const copy = {
  title: await t(copySource.title),
  body: await t(copySource.body),
  cta: await t(copySource.cta),
  href: copySource.href,
};

const exploreLinksSource = [
  { href: "/records", label: "Records" },
  { href: "/management", label: "Management" },
  { href: "/ninetone-nation", label: "Nation" },
  { href: "/news", label: "Nyheter" },
  { href: "/guider", label: "Guider" },
  { href: "/team", label: "Team" },
  { href: "/records/artists/previous", label: "Tidigare artister" },
];

const studioLinksSource = [
  { href: "/records/contact-records", label: "Skicka demo" },
  { href: "/management/contact-management", label: "Förfrågan management" },
  { href: "/ninetone-nation/booking", label: "Boka talang" },
  { href: "/ninetone-nation/contact-ninetone-nation", label: "Press" },
];

// Promise.all, not a template .map() — same async-in-frontmatter rule as
// Header.astro's navItems.
const exploreLinks = await Promise.all(
  exploreLinksSource.map(async (item) => ({ ...item, label: await t(item.label) })),
);
const studioLinks = await Promise.all(
  studioLinksSource.map(async (item) => ({ ...item, label: await t(item.label) })),
);

// Remaining chrome strings — resolved once up front, same rule.
const talkToUsKicker = await t("Berätta för oss");
const exploreKicker = await t("Utforska");
const studioKicker = await t("Studio");
const followKicker = await t("Följ");
const taglineBody = await t(
  "Ett hus för musik, talang, varumärken, offentliga personer och publiken de behöver nå. Sundsvall / Stockholm, Sverige.",
);
const allRightsReserved = await t("Alla rättigheter förbehålls.");
const privacyPolicyLabel = await t("Integritetspolicy");
const cookieSettingsLabel = await t("Cookie-inställningar");
const madeWithCare = await t("Sundsvall — gjord med omsorg.");

const socials = [
  { name: "Instagram", href: "https://www.instagram.com/ninetonemanagement/" },
  { name: "TikTok", href: "https://www.tiktok.com/@ninetone.com?lang=en" },
  { name: "YouTube", href: "https://www.youtube.com/c/Ninetone" },
  { name: "Spotify", href: "https://open.spotify.com/user/ninetone2?si=c124f60ffa214a47" },
  { name: "Apple Music", href: "https://music.apple.com/us/playlist/nmf-ninetone/pl.u-d2b05dYsLeMR9AZ" },
  { name: "SoundCloud", href: "https://soundcloud.com/ninetonegroup" },
  { name: "Facebook", href: "https://www.facebook.com/ninetone/" },
  { name: "Threads", href: "https://www.threads.net/@ninetonegroup" },
  { name: "X / Twitter", href: "https://twitter.com/ninetonegroup" },
  { name: "LinkedIn", href: "https://www.linkedin.com/company/ninetone" },
  { name: "Vimeo", href: "https://vimeo.com/user188122269" },
  { name: "Wikipedia", href: "https://sv.wikipedia.org/wiki/Ninetone_Records" },
];

---

<footer class="bg-ninetone-ink text-ninetone-paper">
  <!-- Demo / talent / booking pitch panel -->
  <section class="border-b border-white/10">
    <div class="mx-auto max-w-7xl px-6 py-16 md:py-24">
      <div>
        <span class="kicker text-ninetone-paper/60">{talkToUsKicker}</span>
        <h2 class="mt-4 font-display text-4xl leading-[1.05] tracking-tight md:text-6xl">
          {copy.title}
        </h2>
        <p class="mt-5 max-w-xl text-base text-ninetone-paper/75 md:text-lg">{copy.body}</p>
        <a
          href={url(copy.href)}
          class={`mt-8 inline-flex items-center gap-3 px-5 py-3 text-sm font-semibold ${accent.cta}`}
        >
          {copy.cta} <span aria-hidden>→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Link columns -->
  <section class="border-b border-white/10">
    <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-10 px-6 py-12 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:gap-10">
      <div class="col-span-2 flex flex-col gap-4 md:col-span-1">
        <a href={url("/")} class="inline-flex items-center gap-3" aria-label="Ninetone Group">
          <img src={url("/images/ninetoneSQlogo.png")} alt="" class="h-12 w-auto" />
          <span class="font-display text-xl font-medium tracking-tight">Ninetone Group</span>
        </a>
        <p class="max-w-xs text-sm text-ninetone-paper/60">
          {taglineBody}
        </p>
      </div>

      <div>
        <span class="kicker text-ninetone-paper/45">{exploreKicker}</span>
        <ul class="mt-4 space-y-2.5 text-sm">
          {exploreLinks.map((item) => (
            <li>
              <a href={url(item.href)} class="text-ninetone-paper/85 transition-colors hover:text-ninetone-paper">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <span class="kicker text-ninetone-paper/45">{studioKicker}</span>
        <ul class="mt-4 space-y-2.5 text-sm">
          {studioLinks.map((item) => (
            <li>
              <a href={url(item.href)} class="text-ninetone-paper/85 transition-colors hover:text-ninetone-paper">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col-span-2 md:col-span-1">
        <span class="kicker text-ninetone-paper/45">{followKicker}</span>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm">
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 text-ninetone-paper/85 transition-colors hover:text-ninetone-paper"
                aria-label={s.name}
              >
                {s.name} <span aria-hidden class="text-[0.625rem] opacity-50">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-3 px-6 py-6 text-xs text-ninetone-paper/50 sm:flex-row sm:items-center">
    <p>© Ninetone Group {new Date().getFullYear()}. {allRightsReserved}</p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <a href={url("/integritet")} class="text-ninetone-paper/65 transition-colors hover:text-ninetone-paper">
        {privacyPolicyLabel}
      </a>
      <button
        type="button"
        data-cookie-settings
        class="text-ninetone-paper/65 transition-colors hover:text-ninetone-paper"
      >
        {cookieSettingsLabel}
      </button>
    </div>
    <p class="font-display italic tracking-tight">{madeWithCare}</p>
  </div>
</footer>

<script>
  // Cookie settings reopener — calls the public API exposed by CookieConsent.astro
  document.querySelectorAll<HTMLButtonElement>("[data-cookie-settings]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const api = (window as unknown as { ninetoneCookieConsent?: { open: () => void } }).ninetoneCookieConsent;
      api?.open();
    });
  });
</script>
