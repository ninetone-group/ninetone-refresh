---
import NewsCard from "./NewsCard.astro";
import { getNews } from "../lib/ninetone";
import { urlFor } from "../lib/url";
import { fmText, sharedT } from "../lib/t";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


interface Props {
  /** Total stories to render. The first becomes the lead, the rest are grid items. */
  limit?: number;
  /** Section heading. */
  heading?: string;
  /** Kicker label rendered above the heading. */
  kicker?: string;
  /** Optional subtitle paragraph rendered under the heading. */
  blurb?: string;
  /** "All news" CTA destination. */
  href?: string;
  /** Visual canvas. "paper" matches the page; "warm" is the off-cream variant. */
  variant?: "paper" | "warm";
}

const {
  limit = 5,
  heading: headingProp,
  kicker: kickerProp,
  blurb,
  href = "/news",
  variant = "warm",
} = Astro.props as Props;

// t() bound to this request (docs/i18n-phase-2-brief.md section 4). Same
// "only translate strings this component owns" rule as RosterStrip.astro —
// see its comment for why `headingProp`/`kickerProp` themselves are NOT
// re-translated here. "All news" has no prop at all (always this
// component's own literal), so it's unconditionally translated below.
const t = sharedT(Astro.locals);
const heading = headingProp ?? (await t("Latest stories."));
const kicker = kickerProp ?? (await t("From the studios"));
const allNewsCta = await t("All news");

const hasNewsVideo = (p: Record<string, unknown>): boolean =>
  ["ytLinkA", "ytLinkB", "ytLinkC", "ytLinkD"].some((k) => {
    const v = p[k];
    return typeof v === "string" && v.trim().length > 0;
  });

let posts: Awaited<ReturnType<typeof getNews>> = [];
try {
  posts = (await getNews()).slice(0, limit);
  // FM CONTENT (decision 8): translate the posts ONCE here, before the cards
  // render. NewsCard only translates its own chrome labels; title and excerpt
  // arrive as props straight from FM, so without this the English homepage
  // showed Swedish headlines. "title" kind for headlines, plain for excerpts,
  // both on the `fast` tier to match what the warm script cached.
  const fm = fmText(Astro.locals);
  posts = await Promise.all(
    posts.map(async (p) => ({
      ...p,
      Title: await fm(String(p.Title ?? ""), "title"),
      shortMessage: await fm(String(p.shortMessage ?? p.Message ?? "")),
    })),
  );
} catch {
  posts = [];
}

// Render nothing when there are no posts. NOTE: this must be a template
// guard, not `return Astro.redirect("")` — that only short-circuits safely
// from a top-level page's frontmatter, before the response starts streaming.
// From a child component, Astro.redirect() still returns a Response object,
// which the parent page's already-streaming renderer then tries to write as
// an HTML chunk — throwing `ResponseSentError` at flush and leaving the
// visitor with an empty body / 500. See docs/seo-phase-1b-brief.md P0 item 3.
const hasPosts = posts.length > 0;
const [lead, ...rest] = posts;

const bg = variant === "warm" ? "bg-ninetone-paper-warm" : "bg-ninetone-paper";

---

{hasPosts && (
  <section class={`${bg} py-20`}>
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-12 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <span class="kicker text-ninetone-ink/55">{kicker}</span>
          <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">{heading}</h2>
          {blurb && (
            <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-ninetone-ink/70">{blurb}</p>
          )}
        </div>
        <a href={url(href)} class="inline-flex items-center gap-2 self-start text-xs font-semibold uppercase tracking-[0.16em] text-ninetone-ink">
          {allNewsCta} <span aria-hidden>→</span>
        </a>
      </div>

      <div class="grid gap-x-12 gap-y-12 md:grid-cols-12">
        {lead && (
          <div class="md:col-span-7">
            <NewsCard
              title={String(lead.Title ?? "")}
              slug={String(lead.slug ?? "")}
              image={lead.image_webp ? String(lead.image_webp) : undefined}
              excerpt={String(lead.shortMessage ?? "")}
              date={String(lead.Date ?? "")}
              author={String(lead["Created By"] ?? "")}
              category={String(lead.category ?? "")}
              hasVideo={hasNewsVideo(lead)}
              size="lg"
            />
          </div>
        )}
        {rest.length > 0 && (
          <ul class="md:col-span-5 space-y-8">
            {rest.map((p) => (
              <li class="border-t border-ninetone-rule pt-6 first:border-0 first:pt-0">
                <NewsCard
                  title={String(p.Title ?? "")}
                  slug={String(p.slug ?? "")}
                  image={p.image_webp ? String(p.image_webp) : undefined}
                  excerpt={String(p.shortMessage ?? "")}
                  date={String(p.Date ?? "")}
                  category={String(p.category ?? "")}
                  hasVideo={hasNewsVideo(p)}
                  size="sm"
                />
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
)}
