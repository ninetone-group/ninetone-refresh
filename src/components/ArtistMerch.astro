---
import MerchCard from './MerchCard.astro';
import {getArtistMerch, getArtistCollections, type ArtistCollections} from '../lib/artist-merch';
import {sectionAccent, type SectionTheme} from '../lib/sections';
import {sharedT} from '../lib/t';
import {artistMerchProfile} from '../lib/artist-merch-profile';
interface Props { artist: ArtistCollections; name:string; theme:SectionTheme; kicker:string; suffix:string }
const {artist,name,theme,kicker,suffix}=Astro.props;
const t=sharedT(Astro.locals);
const openLabel=await t('Se kollektionen');
// Collection navigation survives a transient product endpoint failure. Never
// substitute another store or the entire shop when an ID cannot be resolved.
const merchArtist=await artistMerchProfile(artist,theme).catch(error=>{console.warn('Artist merch profile unavailable',error.message);return artist});
const [collections,products]=await Promise.all([
  getArtistCollections(merchArtist).catch(error=>{console.warn('Artist collections unavailable',error.message);return []}),
  getArtistMerch(merchArtist).catch(error=>{console.warn('Artist products unavailable',error.message);return []}),
]);
---
{(collections.length>0||products.length>0)&&(
<section class="bg-ninetone-paper-warm py-20" aria-label={`${name} merch`}>
 <div class="mx-auto max-w-7xl px-6">
  <div class="mb-10">
   <span class:list={['kicker',sectionAccent[theme].text]}>{kicker}</span>
   <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">{name} — {suffix}</h2>
  </div>
  {products.length>0&&collections.length>0&&<nav class="mb-10 flex flex-wrap gap-3" aria-label={openLabel}>
   {collections.map(c=><a href={c.url} target="_blank" rel="noopener" class="border border-ninetone-rule px-4 py-3 font-mono text-xs uppercase tracking-wider hover:bg-ninetone-paper">{c.title} ↗</a>)}
  </nav>}
  <div class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-4">
   {products.map(product=><MerchCard product={product}/>)}
   {products.length===0&&collections.map(c=><article class="group flex flex-col">
    <a href={c.url} target="_blank" rel="noopener" class="fm-img-frame relative block aspect-square overflow-hidden bg-ninetone-paper">
     {c.image&&<img src={c.image} alt={c.title} width="600" height="600" loading="lazy" class="fm-img h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" onload="this.classList.add('is-loaded'); this.closest('.fm-img-frame')?.classList.add('is-ready')"/>}
     <span class="absolute left-0 top-0 h-1 w-12 bg-ninetone-ink transition-[width] duration-300 group-hover:w-full" aria-hidden></span>
    </a>
    <h3 class="mt-3 font-display text-xl"><a href={c.url} target="_blank" rel="noopener">{c.title}</a></h3>
    <a href={c.url} target="_blank" rel="noopener" class="mt-3 font-mono text-xs uppercase tracking-wider">{openLabel} ↗</a>
   </article>)}
  </div>
 </div>
</section>
)}
