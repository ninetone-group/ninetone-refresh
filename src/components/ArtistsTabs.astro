---
import { urlFor } from "../lib/url";
import { sharedT } from "../lib/t";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


interface Props {
  active: "current" | "previous";
}

const { active } = Astro.props as Props;

const t = sharedT(Astro.locals);
const tabsSource: { key: "current" | "previous"; label: string; href: string }[] = [
  { key: "current", label: "Artists", href: "/records/artists" },
  { key: "previous", label: "Previous Artists", href: "/records/artists/previous" },
];
const tabs = await Promise.all(
  tabsSource.map(async (tb) => ({ ...tb, label: await t(tb.label) })),
);

---

<div class="mb-12 flex items-center gap-6 border-b border-ninetone-rule pb-3">
  {tabs.map((tab) => {
    const isActive = tab.key === active;
    return (
      <a
        href={url(tab.href)}
        class={
          isActive
            ? "relative -mb-3 border-b-2 border-ninetone-red pb-3 text-sm font-semibold text-ninetone-ink"
            : "relative -mb-3 border-b-2 border-transparent pb-3 text-sm font-medium text-ninetone-ink/55 hover:text-ninetone-ink"
        }
        aria-current={isActive ? "page" : undefined}
      >
        {tab.label}
      </a>
    );
  })}
</div>
