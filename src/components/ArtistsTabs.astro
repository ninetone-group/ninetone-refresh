---
import { urlFor } from "../lib/url";
import { sharedT } from "../lib/t";
import { sectionAccent } from "../lib/sections";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


interface Props {
  active: "current" | "previous";
  /** Which roster pair the tabs switch between. Records (artists) by default;
   *  Management renders the clients / previous-clients pair with the navy
   *  accent (2026-09-14). */
  division?: "records" | "management";
}

const { active, division = "records" } = Astro.props as Props;

const t = sharedT(Astro.locals);
const tabsByDivision: Record<"records" | "management", { key: "current" | "previous"; label: string; href: string }[]> = {
  records: [
    { key: "current", label: "Artists", href: "/records/artists" },
    { key: "previous", label: "Previous Artists", href: "/records/artists/previous" },
  ],
  management: [
    { key: "current", label: "Clients", href: "/management/clients" },
    { key: "previous", label: "Previous Clients", href: "/management/clients/previous" },
  ],
};
const tabs = await Promise.all(
  tabsByDivision[division].map(async (tb) => ({ ...tb, label: await t(tb.label) })),
);
const activeBorder = sectionAccent[division].border;

---

<div class="mb-12 flex items-center gap-6 border-b border-ninetone-rule pb-3">
  {tabs.map((tab) => {
    const isActive = tab.key === active;
    return (
      <a
        href={url(tab.href)}
        class={
          isActive
            ? `relative -mb-3 border-b-2 ${activeBorder} pb-3 text-sm font-semibold text-ninetone-ink`
            : "relative -mb-3 border-b-2 border-transparent pb-3 text-sm font-medium text-ninetone-ink/55 hover:text-ninetone-ink"
        }
        aria-current={isActive ? "page" : undefined}
      >
        {tab.label}
      </a>
    );
  })}
</div>
