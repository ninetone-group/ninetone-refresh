---
import type { SectionTheme } from "../lib/sections";
import { sectionAccent } from "../lib/sections";
import { url as basePathOnly, urlFor } from "../lib/url";
import { sharedT } from "../lib/t";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


export interface ContactField {
  type: "text" | "email" | "tel" | "textarea";
  name: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  /** For textarea only — visible row count. */
  rows?: number;
  /** For input fields — 1 spans full width, omit for half-width. */
  cols?: 1 | 2;
}

interface Props {
  /** Theme drives accent color (button + rule). */
  theme?: SectionTheme;
  /** Kicker label above the headline. */
  kicker: string;
  /** Big editorial headline. */
  heading: string;
  /** Optional italic display tagline shown under the heading. */
  tagline?: string;
  /** Lede paragraph. */
  blurb: string;
  /** Optional metric tiles rendered in the left column. */
  metrics?: Array<{ value: string; label: string }>;
  /** Form-side micro headline. */
  formTitle: string;
  /** Form-side description. */
  formBlurb?: string;
  /** Field config — drives the real form layout on the Cloudflare build. */
  fields: ContactField[];
  /** Submit button label. */
  submitLabel: string;
  /**
   * Which division this form delivers to — required so /api/contact can
   * route the email and so the mailto fallback has a sane default address.
   */
  division: "records" | "management" | "nation";
  /** Direct mailbox used on the static build / as the error-state fallback. */
  contactEmail?: string;
}

const DIVISION_EMAIL: Record<Props["division"], string> = {
  records: "office@ninetone.com",
  management: "office@ninetone.com",
  nation: "booking@ninetone.com",
};

const {
  theme = "group",
  kicker,
  heading,
  tagline,
  blurb,
  metrics = [],
  formTitle,
  formBlurb,
  fields,
  submitLabel,
  division,
  contactEmail = DIVISION_EMAIL[division],
} = Astro.props as Props;

const accent = sectionAccent[theme];

// Real form delivery only exists on the Cloudflare (server) build — see
// astro.config.mjs's PUBLIC_HAS_RUNTIME and CLAUDE.md's dual-build note.
// The static GitHub Pages build has no /api/contact behind it, so it must
// keep showing the honest mailto fallback instead of a form that can't send.
const hasRuntime = import.meta.env.PUBLIC_HAS_RUNTIME === true || import.meta.env.PUBLIC_HAS_RUNTIME === "true";

// API ACTION IS LOCALE-NEUTRAL — basePathOnly(), never the locale-bound url().
//
// src/middleware.ts deliberately 404s ^/en/api(/|$) so a locale-prefixed URL
// can never reach the contact/publish handlers; the real endpoint exists only
// at /api/contact. The locale-bound helper this component uses for visitor
// links turned the action into "/en/api/contact" on every English render, so
// both the native form POST and the client-side fetch(form.action) hit that
// deliberate 404 — every English contact submission failed before reaching
// the handler. Same class of regression as the language switch: a path that
// is already complete must not have the current locale re-applied.
const action = basePathOnly("/api/contact");

// t() bound to this request (docs/i18n-phase-2-brief.md section 4). Only
// this component's OWN chrome (honeypot label, legal copy, static-build
// fallback copy) goes through t() here — `kicker`/`heading`/`formTitle`/
// `submitLabel`/etc. are caller-supplied props, translated at their own
// call sites (division landing/contact pages), not this component's job.
const t = sharedT(Astro.locals);
const honeypotLabel = await t("Leave this field blank");
const legalNotice = await t(
  "Genom att skicka in samtycker du till att Ninetone Group AB behandlar dina uppgifter för att besvara din förfrågan. Läs vår",
);
const privacyPolicyLinkLabel = await t("integritetspolicy");
const replyTimeHint = await t("We reply within one business day.");
const sendingLabel = await t("Sending…");
const tooManyAttemptsKicker = await t("Too many attempts");
const tooManyAttemptsMessage = await t("Too many attempts. Try again in a minute.");
const sentKicker = await t("Sent");
const sentMessage = await t("Thanks. We read everything and reply when it's a fit.");
const errorKicker = await t("Something went wrong");
const errorMessagePrefix = await t("Something went wrong. Email us at");
const errorMessageSuffix = await t("instead.");
const emailFallbackBlurb = await t(
  "Please email your enquiry directly. Include the details above so the right team can respond.",
);
const emailLabel = await t("Email");
const mailtoFooter = await t(
  "Your email app will open with a new message. Read our",
);
const privacyPolicyLabel = await t("privacy policy");
const privacyPolicyForLabel = await t("for how we handle personal data.");

---

<section class="bg-ninetone-paper">
  <div class="mx-auto max-w-7xl px-6 pb-16 pt-12 md:pb-24 md:pt-20">
    <div class="grid gap-12 md:grid-cols-12 md:gap-16">
      <!-- Left: editorial intro + metrics -->
      <div class="md:col-span-6">
        <span class={`kicker ${accent.text}`}>{kicker}</span>
        <h1 class="mt-6 font-display text-[clamp(2.5rem,6vw,5rem)] leading-[0.95] tracking-[-0.035em]">
          {heading}
        </h1>
        {tagline && (
          <p class="mt-6 max-w-xl font-display text-2xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-3xl">
            {tagline}
          </p>
        )}
        <p class="mt-6 max-w-xl text-base leading-relaxed text-ninetone-ink/70 md:text-lg">{blurb}</p>

        {metrics.length > 0 && (
          <dl class="mt-12 grid gap-x-6 gap-y-8 sm:grid-cols-2 md:grid-cols-4">
            {metrics.map((m) => (
              <div>
                <span class={`block h-px w-10 ${accent.bg}`} aria-hidden></span>
                <dd class="mt-3 font-display text-4xl font-medium leading-none tracking-[-0.02em]">{m.value}</dd>
                <dt class="mt-2 font-mono text-[0.625rem] uppercase tracking-[0.12em] text-ninetone-ink/55">{m.label}</dt>
              </div>
            ))}
          </dl>
        )}
      </div>

      <!-- Right: form card (Cloudflare build) or direct-email card (static build) -->
      <div class="md:col-span-6">
        <div class="border border-ninetone-rule bg-ninetone-paper-warm p-6 md:p-8">
          <span class={`kicker ${accent.text}`}>{accent.label}</span>
          <h2 class="mt-3 font-display text-3xl leading-tight tracking-tight md:text-4xl">{formTitle}</h2>
          {formBlurb && (
            <p class="mt-3 text-sm text-ninetone-ink/65">{formBlurb}</p>
          )}

          {hasRuntime ? (
            <div data-contact-wrapper>
            <form
              class="mt-8 grid gap-5"
              method="post"
              action={action}
              data-contact-form
              data-division={division}
              data-fallback-email={contactEmail}
            >
              <input type="hidden" name="division" value={division} />

              {/* Honeypot — hidden from sighted and AT users, left blank by humans. */}
              <div class="absolute -left-[9999px]" aria-hidden="true">
                <label>
                  {honeypotLabel}
                  <input type="text" name="website" tabindex={-1} autocomplete="off" aria-hidden="true" />
                </label>
              </div>

              {fields.map((f) => {
                if (f.type === "textarea") {
                  return (
                    <label class="grid gap-1.5">
                      <span class="font-mono text-[0.625rem] uppercase tracking-[0.16em] text-ninetone-ink/65">
                        {f.label}{f.required && <span class={`ml-1 ${accent.text}`}>*</span>}
                      </span>
                      <textarea
                        name={f.name}
                        rows={f.rows ?? 4}
                        placeholder={f.placeholder}
                        required={f.required}
                        class="w-full border border-ninetone-ink/15 bg-ninetone-paper px-3 py-2.5 text-sm text-ninetone-ink placeholder-ninetone-ink/35 focus:border-ninetone-ink focus:outline-none"
                      ></textarea>
                    </label>
                  );
                }
                const colSpan = f.cols === 1 ? "sm:col-span-2" : "";
                return (
                  <label class={`grid gap-1.5 ${colSpan}`}>
                    <span class="font-mono text-[0.625rem] uppercase tracking-[0.16em] text-ninetone-ink/65">
                      {f.label}{f.required && <span class={`ml-1 ${accent.text}`}>*</span>}
                    </span>
                    <input
                      type={f.type}
                      name={f.name}
                      placeholder={f.placeholder}
                      required={f.required}
                      class="min-h-11 w-full border border-ninetone-ink/15 bg-ninetone-paper px-3 py-2.5 text-sm text-ninetone-ink placeholder-ninetone-ink/35 focus:border-ninetone-ink focus:outline-none"
                    />
                  </label>
                );
              })}

              <p class="mt-4 text-[0.6875rem] leading-relaxed text-ninetone-ink/55">
                {legalNotice} <a href={url("/integritet")} class="underline underline-offset-2 hover:text-ninetone-ink">{privacyPolicyLinkLabel}</a>.
              </p>

              <div class="mt-3 flex items-center justify-between gap-3">
                <p class="text-[0.6875rem] text-ninetone-ink/50" data-form-hint>
                  {replyTimeHint}
                </p>
                <button
                  type="submit"
                  class={`min-h-11 inline-flex items-center gap-2 px-5 py-3 text-sm font-semibold ${accent.cta} transition-colors disabled:cursor-not-allowed disabled:opacity-60`}
                >
                  <span data-form-button-label>{submitLabel}</span> <span aria-hidden>→</span>
                </button>
              </div>

            </form>
              <div
                data-form-result
                class="hidden mt-2 border-t border-ninetone-rule pt-4"
                role="status"
                aria-live="polite"
                data-i18n-sending={sendingLabel}
                data-i18n-too-many-kicker={tooManyAttemptsKicker}
                data-i18n-too-many-message={tooManyAttemptsMessage}
                data-i18n-sent-kicker={sentKicker}
                data-i18n-sent-message={sentMessage}
                data-i18n-error-kicker={errorKicker}
                data-i18n-error-prefix={errorMessagePrefix}
                data-i18n-error-suffix={errorMessageSuffix}
              >
                <span class={`kicker ${accent.text}`} data-form-result-kicker></span>
                <p class="mt-2 text-sm leading-relaxed text-ninetone-ink/80" data-form-result-message></p>
              </div>
            </div>
          ) : (
            <div class="mt-8 border-t border-ninetone-rule pt-6">
              <p class="max-w-md text-sm leading-relaxed text-ninetone-ink/65">
                {emailFallbackBlurb}
              </p>
              <a
                href={`mailto:${contactEmail}`}
                class={`mt-6 inline-flex min-h-11 items-center gap-2 px-5 py-3 text-sm font-semibold ${accent.cta} transition-colors`}
              >
                {emailLabel} {contactEmail} <span aria-hidden>→</span>
              </a>
              <p class="mt-5 text-[0.6875rem] leading-relaxed text-ninetone-ink/55">
                {mailtoFooter} <a href={url("/integritet")} class="underline underline-offset-2 hover:text-ninetone-ink">{privacyPolicyLabel}</a> {privacyPolicyForLabel}
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

{hasRuntime && (
  <script>
    document.querySelectorAll<HTMLFormElement>("form[data-contact-form]").forEach((form) => {
      const wrapper = form.closest<HTMLElement>("[data-contact-wrapper]") ?? form.parentElement;
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const buttonLabel = form.querySelector<HTMLElement>("[data-form-button-label]");
      const hint = form.querySelector<HTMLElement>("[data-form-hint]");
      const result = wrapper?.querySelector<HTMLElement>("[data-form-result]") ?? null;
      const resultKicker = wrapper?.querySelector<HTMLElement>("[data-form-result-kicker]") ?? null;
      const resultMessage = wrapper?.querySelector<HTMLElement>("[data-form-result-message]") ?? null;
      const fallbackEmail = form.dataset.fallbackEmail || "hello@ninetone.com";
      const originalLabel = buttonLabel?.textContent ?? "Send";

      // Bridge pattern (docs/i18n-phase-2-brief.md section 4, note 4): this
      // <script> runs client-side with no Astro.locals, so it cannot call
      // t() itself. Every string it needs was resolved server-side in the
      // frontmatter above and threaded through as data-i18n-* attributes on
      // [data-form-result] — read once here rather than re-authored in
      // English inline.
      const i18n = {
        sending: result?.dataset.i18nSending || "Sending…",
        tooManyKicker: result?.dataset.i18nTooManyKicker || "Too many attempts",
        tooManyMessage: result?.dataset.i18nTooManyMessage || "Too many attempts. Try again in a minute.",
        sentKicker: result?.dataset.i18nSentKicker || "Sent",
        sentMessage: result?.dataset.i18nSentMessage || "Thanks. We read everything and reply when it's a fit.",
        errorKicker: result?.dataset.i18nErrorKicker || "Something went wrong",
        errorPrefix: result?.dataset.i18nErrorPrefix || "Something went wrong. Email us at",
        errorSuffix: result?.dataset.i18nErrorSuffix || "instead.",
      };

      function errorMessage(): string {
        return `${i18n.errorPrefix} <a href="mailto:${fallbackEmail}" class="underline underline-offset-2 hover:text-ninetone-ink">${fallbackEmail}</a> ${i18n.errorSuffix}`;
      }

      function showResult(kind: "success" | "error", kickerText: string, message: string) {
        if (!result || !resultKicker || !resultMessage) return;
        result.classList.remove("hidden");
        resultKicker.textContent = kickerText;
        resultMessage.innerHTML = message;
        result.dataset.state = kind;
        if (hint) hint.classList.add("hidden");
      }

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!button || !buttonLabel) return;

        button.disabled = true;
        buttonLabel.textContent = i18n.sending;

        try {
          const formData = new FormData(form);
          const payload: Record<string, string> = {};
          formData.forEach((value, key) => {
            payload[key] = String(value);
          });

          const res = await fetch(form.action, {
            method: "POST",
            credentials: "same-origin",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          if (res.status === 429) {
            showResult("error", i18n.tooManyKicker, i18n.tooManyMessage);
            button.disabled = false;
            buttonLabel.textContent = originalLabel;
            return;
          }

          const data = await res.json().catch(() => null);

          if (res.ok && data?.ok) {
            form.reset();
            form.hidden = true;
            showResult("success", i18n.sentKicker, i18n.sentMessage);
            return;
          }

          showResult("error", i18n.errorKicker, errorMessage());
          button.disabled = false;
          buttonLabel.textContent = originalLabel;
        } catch {
          showResult("error", i18n.errorKicker, errorMessage());
          button.disabled = false;
          buttonLabel.textContent = originalLabel;
        }
      });
    });
  </script>
)}
