---
import Base from "../../layouts/Base.astro";
import StreamingRow from "../../components/StreamingRow.astro";
import NewsCard from "../../components/NewsCard.astro";
import MerchCard from "../../components/MerchCard.astro";
import RosterStrip from "../../components/RosterStrip.astro";
import YouTubeFeed from "../../components/YouTubeFeed.astro";
import { getBookingPageSet, getBookingCategories, getNewsForArtist, pickRelatedArtists } from "../../lib/ninetone";
import { resolveChannelId, getYouTubeFeed } from "../../lib/youtube";
import { getProducts } from "../../lib/shopify";
import { renderBio } from "../../lib/markdown";
import { urlFor } from "../../lib/url";
import { pageJsonLdOrigin } from "../../lib/site";
import { breadcrumbs, person, markdownToPlainText } from "../../lib/schema";
import { notFound } from "../../lib/not-found";
import { fmText, sharedT } from "../../lib/t";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


// Generate a page for every Active talent listed on the booking page.
// Source of truth = the curated BOOKING_TAG portal set, filtered to
// filterActive=Active (see getBookingPageSet). Keeps the linked-from-list
// set and the page-exists set in lockstep; no orphan links, no 404s.
export async function getStaticPaths() {
  const { slugs, records, allRoster } = await getBookingPageSet();
  return slugs
    .map((slug) => records.get(slug))
    .filter((e): e is Record<string, unknown> => Boolean(e))
    .map((entertainer) => ({
      params: { slug: String(entertainer.SLUG ?? "") },
      props: { entertainer, allRoster },
    }));
}

// Static build (gh): entertainer arrives via getStaticPaths props.
// Live server (cf): resolve at request time from the same curated set.
let { entertainer: e, allRoster } = Astro.props as {
  entertainer?: Record<string, unknown>;
  allRoster?: Record<string, unknown>[];
};
if (!e || !allRoster) {
  const { slugs, records, allRoster: roster } = await getBookingPageSet();
  const slug = String(Astro.params.slug ?? "");
  e = slugs.includes(slug) ? records.get(slug) : undefined;
  allRoster = roster;
  if (!e) return notFound(() => Astro.rewrite("/404"));
}

const name = String(e["Head Artist"] ?? "");
// FM CONTENT (decision 8 / Definition of done). The entity's own name goes
// into `protect` so it is never "translated" into nonsense, and prose is
// translated on the `fast` tier — the same tier scripts/translate-warm.mjs
// used, so these read the already-warmed entries rather than paying again.
const fm = fmText(Astro.locals, { protect: [name] });
const tagline = await fm(String(e.bookingPresentationTitle ?? ""));
const bioHtml = renderBio(await fm(String(e.bookingPresentationString ?? ""), "markdown"));
const heroImage = e.artistPicture_big
  ? String(e.artistPicture_big)
  : e.artistPicture_small
  ? String(e.artistPicture_small)
  : undefined;
// worker-fm-proxy /booking/:slug/big|small are verified fixed sizes
// (1000×1000 / 500×500) — track whichever field heroImage resolved to.
const heroImageSize = e.artistPicture_big ? 1000 : 500;
const tags = (e.tagBooking
  ? String(e.tagBooking).split(/\r|\n|,/).map((s) => s.trim()).filter(Boolean)
  : e.tags
  ? String(e.tags).split(/\r|\n|,/).map((s) => s.trim()).filter(Boolean)
  : e.genre
  ? String(e.genre).split(/\r|\n|,/).map((s) => s.trim()).filter(Boolean)
  : []);
const ytOne = String(e.yotubeHighlight_one ?? "");
const ytTwo = String(e.yotubeHighlight_two ?? "");
const collectionId = String(e.collectionId ?? "").trim();

const socials = {
  spotify: e.url_spotify ? String(e.url_spotify) : undefined,
  apple: e.url_applemusic ? String(e.url_applemusic) : undefined,
  amazon: e.url_amazon ? String(e.url_amazon) : undefined,
  youtubeMusic: e.url_youtube_music ? String(e.url_youtube_music) : undefined,
  youtube: e.url_youtube_link ? String(e.url_youtube_link) : undefined,
  instagram: e.url_instagram ? String(e.url_instagram) : undefined,
  tiktok: e.url_tiktok_artist ? String(e.url_tiktok_artist) : undefined,
  twitter: e.url_twitter ? String(e.url_twitter) : undefined,
  facebook: e.url_facebook ? String(e.url_facebook) : undefined,
  soundcloud: undefined,
};

let merch: Awaited<ReturnType<typeof getProducts>> = [];
if (collectionId) {
  try { merch = await getProducts({ collectionId, limit: 8 }); } catch (err) {
    console.error("[nation] merch fetch failed:", err);
  }
}

let latestNews: Awaited<ReturnType<typeof getNewsForArtist>> = [];
try { latestNews = await getNewsForArtist(name, 4); } catch (err) {
  console.error("[nation] news strip failed:", err);
}
// FM CONTENT (decision 8): the "In the news" cards render FM headlines and
// excerpts. NewsCard translates only its own chrome labels, so without this
// the block stayed Swedish on /en/ while the bio above it was English.
// Pre-resolved here — fm() is async and these render in a .map().
latestNews = await Promise.all(
  latestNews.map(async (p) => ({
    ...p,
    Title: await fm(String(p.Title ?? "")),
    shortMessage: await fm(String(p.shortMessage ?? p.Message ?? "")),
  })),
);

// "In good company" — same-tag entertainers ranked by overlap, padded with
// random others if there aren't enough matches.
function nationTagsOf(r: Record<string, unknown>): string[] {
  const raw = (r.tagBooking ?? r.tags ?? r.genre ?? "") as string;
  return String(raw).split(/\r|\n|,/).map((s) => s.trim()).filter(Boolean);
}
const related = pickRelatedArtists(e, allRoster, nationTagsOf, 12);

const ytLinks = [ytOne, ytTwo].filter(Boolean);

// YouTube feed: latest 5 + top 5 most-viewed for talent with a usable
// channel URL. Errors out silently — section just doesn't render if the
// channel can't be resolved or the fetch fails.
const ytChannelUrl = String(e.url_youtube_link ?? "");
let ytFeed: Awaited<ReturnType<typeof getYouTubeFeed>> | null = null;
try {
  const channelId = await resolveChannelId(ytChannelUrl);
  if (channelId) ytFeed = await getYouTubeFeed(channelId);
} catch {}

const slug = String(e.SLUG ?? "");
const origin = pageJsonLdOrigin(Astro.request);

// `tags` (above) is derived from e.tagBooking/e.tags/e.genre, but `e` comes
// from API_Booking (getBookingPageSet/getBookingRoster), which carries none
// of those fields — the actual booking category lives one level up, on the
// API_BOOKING_TAG record this talent is portalled under. getBookingCategories()
// is already fetched (and response-cached — see src/lib/filemaker.ts's
// `cached()` wrapper) by the booking index; calling it again here reuses
// that cache rather than issuing a new FM read.
const bookingCategories = await getBookingCategories();
const additionalType = bookingCategories
  .filter((c) => c.artists.some((a) => a.slug === slug))
  .map((c) => c.tag);

const jsonLd = [
  breadcrumbs(origin, [
    { name: "Nation", path: "/ninetone-nation" },
    { name: "Booking", path: "/ninetone-nation/booking" },
    { name, path: `/ninetone-nation/${slug}` },
  ]),
  person(origin, name, {
    role: "nation",
    path: `ninetone-nation/${slug}`,
    image: heroImage,
    description: tagline || markdownToPlainText(String(e.bookingPresentationString ?? ""), 200),
    socials,
    bookingCategories: additionalType,
  }),
];

// t() bound to this request (docs/i18n-phase-2-brief.md section 4), scoped
// to the "More from Nation" RosterStrip chrome only — see the analogous
// comment in src/pages/records/artists/[slug].astro for why this page's
// other strings are not yet converted in this pass.
const t = sharedT(Astro.locals);
const moreFromNationKicker = await t("More from Nation");
const availableNowHeading = await t("Available now.");
const allEntertainersCta = await t("All entertainers");

// Second pass (docs/i18n-phase-2-brief.md section 4): the rest of this
// page's own chrome — first pass covered only the RosterStrip block above.
const backToBookingLabel = await t("← Nation · Booking");
const bookLabel = await t("Book");
const bookingKicker = await t("Nation — Booking");
const watchKicker = await t("Watch");
const bookingSectionKicker = await t("Booking");
const readyToBookPrefix = await t("Ready to book");
const availabilityBlurb = await t(
  "Get availability, fee structure, and technical requirements within one business day.",
);
const sendBookingRequestLabel = await t("Send booking request");
const inTheNewsKicker = await t("In the news");
const merchKicker = await t("Merch");
const officialSuffix = await t("official.");

---

<Base
  title={name}
  theme="nation"
  description={tagline || `${name} | Ninetone Nation`}
  ogImage={heroImage}
  ogType="profile"
  jsonLd={jsonLd}
>
  <section class="bg-ninetone-paper">
    <div class="mx-auto max-w-7xl px-6 pb-12 pt-12 md:pt-16">
      <p class="mb-8">
        <a href={url("/ninetone-nation/booking")} class="kicker text-ninetone-ink/55 hover:text-ninetone-ink">{backToBookingLabel}</a>
      </p>

      <div class="grid gap-10 md:grid-cols-12 md:gap-16">
        <aside class="md:col-span-5 lg:col-span-5">
          <div class="md:sticky md:top-24">
            <div class="fm-img-frame relative aspect-[4/5] w-full overflow-hidden bg-ninetone-paper-warm">
              {heroImage && (
                <img
                  src={heroImage}
                  alt={name}
                  width={heroImageSize}
                  height={heroImageSize}
                  class="fm-img h-full w-full object-cover"
                  fetchpriority="high"
                  onload="this.classList.add('is-loaded'); this.closest('.fm-img-frame')?.classList.add('is-ready')"
                />
              )}
              <span class="absolute left-0 top-0 h-1 w-16 bg-ninetone-green" aria-hidden></span>
            </div>
            <div class="mt-6 hidden md:block">
              <StreamingRow socials={socials} />
            </div>
            <a
              href={url("/ninetone-nation/contact-ninetone-nation")}
              class="mt-6 hidden w-full items-center justify-center gap-2 bg-ninetone-green px-4 py-3 text-sm font-semibold text-ninetone-paper transition-colors hover:bg-ninetone-green-dark md:inline-flex"
            >
              {bookLabel} {name} <span aria-hidden>→</span>
            </a>
          </div>
        </aside>

        <div class="md:col-span-7 lg:col-span-7">
          <span class="kicker text-ninetone-green-dark">{bookingKicker}</span>
          <h1 class="mt-4 font-display text-[clamp(3rem,8vw,7rem)] leading-[0.9] tracking-[-0.045em]">{name}</h1>

          {tagline && (
            <p class="mt-6 max-w-xl font-display text-2xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-3xl">
              {tagline}
            </p>
          )}

          {tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-xs uppercase tracking-[0.16em] text-ninetone-ink/60">
              {tags.slice(0, 6).map((g, i) => (
                <span>{i > 0 && <span aria-hidden class="mr-4 opacity-40">·</span>}{g}</span>
              ))}
            </div>
          )}

          <div class="mt-8 md:hidden">
            <StreamingRow socials={socials} />
          </div>

          <a
            href={url("/ninetone-nation/contact-ninetone-nation")}
            class="mt-6 inline-flex items-center gap-2 bg-ninetone-green px-4 py-3 text-sm font-semibold text-ninetone-paper transition-colors hover:bg-ninetone-green-dark md:hidden"
          >
            {bookLabel} {name} <span aria-hidden>→</span>
          </a>

          <div class="mt-12 prose lede max-w-none" set:html={bioHtml}></div>

          {ytLinks.length > 0 && (
            <div class="mt-16 border-t border-ninetone-rule pt-10">
              <span class="kicker text-ninetone-ink/55">{watchKicker}</span>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {ytLinks.map((url) => {
                  const idMatch = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
                  const id = idMatch ? idMatch[1] : null;
                  return id ? (
                    <iframe src={`https://www.youtube.com/embed/${id}`} class="aspect-video w-full" title={`${name} video`} loading="lazy" allowfullscreen></iframe>
                  ) : null;
                })}
              </div>
            </div>
          )}

          <!-- Booking technical / inquiry block -->
          <div class="mt-16 border-t border-ninetone-rule pt-10">
            <span class="kicker text-ninetone-green-dark">{bookingSectionKicker}</span>
            <div class="mt-4 grid gap-6 md:grid-cols-2">
              <div>
                <p class="font-display text-2xl font-medium leading-tight tracking-tight">{readyToBookPrefix} {name}?</p>
                <p class="mt-3 text-sm text-ninetone-ink/65">
                  {availabilityBlurb}
                </p>
              </div>
              <div class="flex flex-col gap-3 md:items-end md:text-right">
                <a
                  href={url("/ninetone-nation/contact-ninetone-nation")}
                  class="inline-flex items-center gap-2 self-start bg-ninetone-green px-4 py-3 text-sm font-semibold text-ninetone-paper transition-colors hover:bg-ninetone-green-dark md:self-end"
                >
                  {sendBookingRequestLabel} <span aria-hidden>→</span>
                </a>
                <a href="mailto:booking@ninetone.com" class="text-sm text-ninetone-ink/70 underline-offset-4 hover:underline">
                  booking@ninetone.com
                </a>
              </div>
            </div>
          </div>

          {latestNews.length > 0 && (
            <div class="mt-16 border-t border-ninetone-rule pt-10">
              <span class="kicker text-ninetone-ink/55">{inTheNewsKicker}</span>
              <ul class="mt-6 grid gap-x-8 gap-y-10 md:grid-cols-2">
                {latestNews.map((p) => (
                  <li>
                    <NewsCard
                      title={String(p.Title ?? "")}
                      slug={String(p.slug ?? "")}
                      image={p.image_webp ? String(p.image_webp) : undefined}
                      date={String(p.Date ?? "")}
                      category={String(p.category ?? "")}
                      hasVideo={["ytLinkA","ytLinkB","ytLinkC","ytLinkD"].some((k) => typeof (p as Record<string, unknown>)[k] === "string" && ((p as Record<string, unknown>)[k] as string).trim().length > 0)}
                      size="sm"
                    />
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <YouTubeFeed feed={ytFeed} clientName={name} theme="nation" />

  {merch.length > 0 && (
    <section class="bg-ninetone-paper-warm py-20">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mb-10">
          <span class="kicker text-ninetone-green-dark">{merchKicker}</span>
          <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">{name} — {officialSuffix}</h2>
        </div>
        <div class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-4">
          {merch.map((p) => <MerchCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <RosterStrip
      artists={related}
      theme="nation"
      hrefBase="/ninetone-nation"
      kicker={moreFromNationKicker}
      heading={availableNowHeading}
      cta={{ label: allEntertainersCta, href: "/ninetone-nation/booking" }}
    />
  )}
</Base>
