---
import Base from "../../layouts/Base.astro";
import SplitPortalHero from "../../components/SplitPortalHero.astro";
import WebPostsSection from "../../components/WebPostsSection.astro";
import LatestNewsSection from "../../components/LatestNewsSection.astro";
import { getWebPostSection } from "../../lib/ninetone";
import { sharedT } from "../../lib/t";

const webPosts = await getWebPostSection("Ninetone Nation");

// t() bound to this request (docs/i18n-phase-2-brief.md section 4).
// "Ninetone Nation" is a proper noun — not translated, per rule 3.
const t = sharedT(Astro.locals);
const description = await t(
  "Sweden's leading artists, hosts and speakers, available for your event — meet Ninetone Nation's talent and booking team.",
);
const entertainersLabel = await t("Entertainers");
const entertainersBlurb = await t("Sweden's leading artists, hosts, and speakers — available for your event.");
const theTeamLabel = await t("The team");
const theTeamBlurb = await t("The booking desk — the people handling every detail behind the scenes.");
---

<Base
  title="Ninetone Nation"
  theme="nation"
  description={description}
>
  {/* Page-level H1. Visually hidden because this archetype's identity is
      carried by the portal tiles and the kicker, and DESIGN.md fixes that
      treatment — but the page still needs exactly one heading that names it,
      and it must belong to the PAGE, not to whichever tile happens to render
      first inside a shared component. */}
  <h1 class="sr-only">Ninetone Nation</h1>

  <SplitPortalHero
    theme="nation"
    kicker="Ninetone Nation"
    left={{
      href: "/ninetone-nation/booking",
      label: entertainersLabel,
      blurb: entertainersBlurb,
      bgImage: "/images/nationBannerSection.png",
    }}
    right={{
      href: "/team",
      label: theTeamLabel,
      blurb: theTeamBlurb,
      bgImage: "/images/meetTheTeamBanner.png",
    }}
  />
  <WebPostsSection data={webPosts} />
  <LatestNewsSection />
</Base>
