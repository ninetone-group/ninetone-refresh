---
import Base from "../layouts/Base.astro";
import BentoGrid from "../components/BentoGrid.astro";
import BentoTile from "../components/BentoTile.astro";
import RosterStrip from "../components/RosterStrip.astro";
import MetricsPanel from "../components/MetricsPanel.astro";
import EditorialNewsBlock from "../components/EditorialNewsBlock.astro";
import MarqueeBand from "../components/MarqueeBand.astro";
import MerchSection from "../components/MerchSection.astro";
import { sectionAccent } from "../lib/sections";
import { hoverArtBackground } from "../lib/hover-art";
import { urlFor } from "../lib/url";
import { fmText, sharedT } from "../lib/t";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);

import {
  getFeaturedArtists,
  getArtistOfTheWeek,
  getArtistBySlug,
  getLatestClient,
  getNews,
} from "../lib/ninetone";

// t() bound to this request (docs/i18n-phase-2-brief.md section 4). See the
// PR description's budget note: this page alone, plus the Header/Footer/
// CommandPalette chrome it always renders alongside via Base.astro, exceeds
// the 25-uncached-call-per-render ceiling on a cold cache (fresh deploy, or
// a TRANSLATION_KEY_VERSION bump) — flagged rather than silently shipped.
// sharedT() (src/lib/t.ts) still gives this page's own strings + Header's +
// Footer's ONE combined budget rather than one each, which is the most this
// call site can do about it without touching translate.ts (out of scope).
const t = sharedT(Astro.locals);

const collectionId =
  import.meta.env.SHOPIFY_HOMEPAGE_COLLECTION_ID ||
  (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env
    ?.SHOPIFY_HOMEPAGE_COLLECTION_ID;

// Core homepage content — failures render the error page (never edge-cached)
// instead of a silently-gutted homepage. Transients are absorbed by lib/cache.ts.
// The two "in focus" picks share the cached roster fetches — no extra FM calls.
const [featuredArtists, heroArtist, heroClient, latestNews] = await Promise.all([
  getFeaturedArtists(20),
  getArtistOfTheWeek(), // rotates Mondays 00:00 UTC — same artist all week
  getLatestClient(), // newest management addition (FM recordId order)
  getNews().then((p) => p.slice(0, 4)),
]);

// getArtistOfTheWeek() sources from the API_ARTIST roster layout, which
// (verified live on staging) carries only artistPicture_small — never _big —
// unlike API_Management (heroClient below). The `??` here used to read as a
// "prefer big" fallback but was actually always resolving to small, loading
// a 500×500 image with fetchpriority="high" into this 610px-tall feature
// tile as the page's LCP element. Fetch the real detail record (same
// API_ARTIST_DETAIL lookup every artist page already uses) to get the
// genuine 1000×1000 big picture instead of guessing from roster fields.
const heroArtistDetail = heroArtist?.SLUG ? await getArtistBySlug(String(heroArtist.SLUG)) : undefined;
const heroArtistImage = heroArtistDetail?.artistPicture_big ?? heroArtist?.artistPicture_small;
const heroArtistImageSize = heroArtistDetail?.artistPicture_big ? 1000 : 500;
const heroArtistName = String(heroArtist?.["Head Artist"] ?? "");

const heroClientImage = heroClient?.artistPicture_big ?? heroClient?.artistPicture_small;
const heroClientImageSize = heroClient?.artistPicture_big ? 1000 : 500;
const heroClientName = String(heroClient?.["Head Artist"] ?? "");

const featuredNewsItem = latestNews[0];

// Marquee names — top 12 active artists
const marqueeNames = featuredArtists
  .slice(0, 12)
  .map((a) => String(a["Head Artist"] ?? ""))
  .filter(Boolean);

const portalsSource = [
  { theme: "records" as const, title: "Records", href: "/records", banner: "/images/recordsBanner.png", tagline: "From song to universe.", blurb: "Vi hjälper artister att förvandla musik till något större än en release — från A&R och produktion till berättelse, visuell identitet och långsiktig artistutveckling." },
  { theme: "management" as const, title: "Management", href: "/management", banner: "/images/managementBanner.png", tagline: "Backoffice for public people.", blurb: "Struktur, strategi och riktning för kreatörer, influencers, sportprofiler och TV-personligheter som redan har publikens uppmärksamhet." },
  { theme: "nation" as const, title: "Nation", href: "/ninetone-nation", banner: "/images/nationBanner.png", tagline: "Talent, attention and live moments.", blurb: "Vi kopplar artister, profiler, speakers och underhållare till scener, varumärken och events där deras närvaro skapar faktisk effekt." },
];
// Every hardcoded string on this page is translated in frontmatter (t() is
// async — src/lib/translate.ts), never inside the template's .map(), per
// constraint 2. Each literal keeps whatever language it was already written
// in (decision 5) — this page mixes English taglines with Swedish blurbs
// verbatim, so both stay as their own t() source rather than being
// rewritten to match each other.
const portals = await Promise.all(
  portalsSource.map(async (p) => ({
    ...p,
    title: await t(p.title),
    tagline: await t(p.tagline),
    blurb: await t(p.blurb),
  })),
);

// Hero section
const heroKicker = await t("Sundsvall / Stockholm — since 2006");
const heroH1 = await t("We connect what people need with what people care about.");
const heroBody = await t(
  "Ninetone är länken mellan behov, erbjudanden och publik. Vi hjälper artister, kreatörer, organisationer, företag, idrottslag och offentliga personer att förstå vad de egentligen erbjuder — och hur det ska formuleras, paketeras och nå fram.",
);
const heroTagline = await t(
  "Vi arbetar där kultur, kommunikation, algoritmer, underhållning, sociala medier och mänskligt beteende möts.",
);
const talkToUsCta = await t("Talk to us"); // reused verbatim at both hero + closing CTA — sharedT() memoizes, so this is ONE call even though it renders twice.
const seeWhatWeDoCta = await t("See what we do");

// Positioning band
const positioningKicker = await t("Positioning");
const positioningH2 = await t("Not a label. Not an agency. Not traditional management.");
const positioningTagline = await t("Ninetone är ett kommunikations- och utvecklingshus för den moderna uppmärksamhetsekonomin.");
const positioningBody = await t(
  "Ibland arbetar vi med musik. Ibland med influencers. Ibland med företag, organisationer, idrottslag, TV-profiler eller kreatörer. Men uppgiften är nästan alltid densamma: att förstå ett behov. Förädla ett erbjudande. Och bygga bron till de människor som behöver känna, förstå, köpa, följa, lyssna, komma, rösta, dela eller bry sig.",
);

// Portal band per-card "Enter" affordance + kicker
const enterLabel = await t("Enter");
const ninetoneKicker = await t("Ninetone");

// "What we do" vignette band
const howWeWorkKicker = await t("How we work");
const buildBridgeH2 = await t("We build the bridge.");
const howWeWorkTagline = await t("Varje uppdrag börjar med samma fråga: vad behöver kopplas ihop?");
const sportKicker = await t("Sport · Idrottsklubb");
const sportBody = await t(
  "Att förstå klubbens behov av publik, energi, biljettförsäljning och starkare relation till fansen. Ninetone arbetar med budskap, kanalval, rådgivning till ledningen och kommunikation som kan fylla läktarna och stärka klubbens närvaro i människors vardag.",
);
const orgKicker = await t("Organisation");
const orgBody = await t(
  "Att tydliggöra värdet i deras tjänster, formulera erbjudandet tillsammans med ledningen och nå Sveriges företagare på ett sätt som känns relevant, konkret och användbart.",
);
const musicKicker = await t("Music · Artist");
const musicHeading = await t("En artist");
const musicBody = await t(
  "Att ta en konstnärlig produkt och bygga ett universum runt den — ljud, berättelse, känsla, kanal, publik och långsiktig riktning.",
);
const creatorKicker = await t("Public person · Creator");
const creatorHeading = await t("En influencer");
const creatorBody = await t("Att omvandla uppmärksamhet till struktur, affär, kreativ utveckling och hållbar karriär.");
const sameCoreTagline = await t("Olika världar. Samma kärna.");
const sameCoreEmphasis = await t("Behov. Erbjudande. Människa.");

// Bento "What's on"
const whatsOnKicker = await t("What's on");
const whatsMovingH2 = await t("What's moving.");
const whatsMovingBody = await t("Projekt, releaser, berättelser och människor vi arbetar med just nu.");
const updatedWeeklyLabel = await t("Updated weekly");
const artistOfWeekKicker = await t("Artist of the week");
// FM CONTENT on the homepage (decision 8). The bento tiles and the Latest
// Story headline render FM prose directly — without this they stayed Swedish
// on /en/ while the chrome around them was English. Names are protected so
// "Hälsingefyr" and "Avdelning 44" are never "translated".
const fm = fmText(Astro.locals, { protect: [heroArtistName, heroClientName].filter(Boolean) });
const heroArtistBlurb = await fm(String(heroArtist?.artistPresentationShort ?? ""));
const heroClientBlurb = await fm(String(heroClient?.clientPresentationShort || heroClient?.artistPresentationShort || ""));
const featuredNewsHeading = await fm(String(featuredNewsItem?.Title ?? ""), "title");

const viewProfileCta = await t("View profile");

// Meta description through t() (SEO audit P2). It was a fixed English string
// for BOTH locales, so the Swedish homepage — lang="sv" — described itself in
// English in <meta name="description">, og:description and twitter:description.
// English is kept as the source string (it is what is authored here today, and
// overrides key on the source hash), so /en is unchanged and /sv gets Swedish.
const metaDescription = await t(
  "Ninetone connects what people need with what people care about — music, talent management and booking for artists, creators and public figures since 2006.",
); // reused for both heroArtist + heroClient tiles — memoized to one call.
const latestStoryKicker = await t("Latest story");
const readCta = await t("Read");
const bookingKicker = await t("Booking");
const bookTalentHeading = await t("Book talent");
const bookTalentBlurb = await t(
  "Artister, profiler, speakers och entertainers för sammanhang där rätt person kan förändra hela rummet.",
);
const openBookingCta = await t("Open booking");
const demosOpenKicker = await t("Demos open");
const weListenHeading = await t("We listen to everything.");
const weListenBlurb = await t(
  "Skicka musiken. Inte för att vi letar efter perfektion, utan för att vi letar efter något som går att bygga vidare på.",
);
const submitCta = await t("Submit");
const managementKicker = await t("Management");
const publicPeopleHeading = await t("Public people need private structure.");
const publicPeopleBlurb = await t("Vi bygger systemet bakom människor som syns.");
const seeClientsCta = await t("See clients");
const clientInFocusKicker = await t("Client in focus");

// Roster strip
const rosterKicker = await t("The roster");
const rosterHeading = await t("People, projects and public attention.");
const rosterBlurb = await t(
  "Här finns artister, kreatörer och profiler vi arbetar med, har byggt med eller hjälper att föra vidare till nästa nivå.",
);
const allArtistsCta = await t("All artists");

// Metrics panel
const byTheNumbersKicker = await t("By the numbers");
const metricsHeading = await t("Quietly moving attention — and behaviour.");
const metricsSource = [
  { value: "342+", label: "Artists, creators and public profiles", note: "Through the years" },
  { value: "18+", label: "Years inside music, media and digital culture", note: "Since 2006" },
  { value: "120+", label: "Active campaigns, releases and collaborations", note: "Across music, social, brand and sport" },
  { value: "1", label: "House built around studios, people and ideas", note: "Sundsvall / Stockholm" },
];
const metrics = await Promise.all(
  metricsSource.map(async (m) => ({ ...m, label: await t(m.label), note: await t(m.note) })),
);

// Editorial news block
const editorialHeading = await t("Stories from the intersection.");
const editorialKicker = await t("From the intersection");
const editorialBlurb = await t("Nyheter från musik, management, varumärken, kreatörer, organisationer och publika projekt.");

// About
const aboutKicker = await t("About");
const aboutParagraphs = await Promise.all(
  [
    "Ninetone Group är ett svenskt utvecklings-, management- och kommunikationshus byggt för den moderna uppmärksamhetsekonomin.",
    "Vi arbetar med människor och organisationer som behöver nå fram: artister, kreatörer, influencers, sportprofiler, företag, idrottslag, organisationer och offentliga personer.",
    "Vår styrka ligger i att förstå både avsändaren och mottagaren. Vad behöver sägas? Vem behöver känna det? Vilken kanal bär budskapet bäst? Hur blir ett erbjudande inte bara synligt, utan relevant?",
    "Därför arbetar vi tvärs över musik, sociala medier, PR, management, affärsutveckling, produktion, storytelling, distribution och publikförståelse.",
    "Vi är inte bara ett musikbolag. Inte bara ett managementbolag. Inte bara en byrå.",
  ].map((p) => t(p)),
);
const aboutClosing = await t("Vi är länken mellan behovet, erbjudandet och människorna på andra sidan.");

// Merch
const merchHeading = await t("The house, wearable.");
const merchKicker = await t("Merch");
const merchBlurb = await t(
  "Kläder och objekt från Ninetone-världen. Enkla saker för människor som rör sig nära musiken, projekten och kulturen runt huset.",
);

// Closing CTA band
const closingKicker = talkToUsCta; // same source string as the hero CTA ("Talk to us") — reuse the resolved value instead of a second t() call.
const closingH2 = await t("Tell us what needs to move.");
const closingBody = await t(
  "Har du musik som behöver hitta rätt publik, en profil som behöver struktur, ett företag som behöver formulera sitt erbjudande eller en organisation som behöver nå fram? Börja där. Vi hjälper dig att bygga bron.",
);

---

<Base
  title="Ninetone Group"
  theme="group"
  description={metaDescription}
>
  <!-- Typographic hero -->
  <section class="relative overflow-hidden bg-ninetone-paper">
    <div class="mx-auto max-w-7xl px-6 pb-16 pt-20 md:pb-24 md:pt-28">
      <div class="grid gap-10 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-8">
          <span class="kicker text-ninetone-ink/55">{heroKicker}</span>
          <h1 class="mt-6 font-display text-[clamp(3rem,9vw,8rem)] leading-[0.9] tracking-[-0.04em]">
            {heroH1}
          </h1>
        </div>
        <div class="flex flex-col justify-end gap-4 md:col-span-4">
          <p class="text-lg leading-relaxed text-ninetone-ink/75">
            {heroBody}
          </p>
          <p class="font-display text-lg italic leading-snug tracking-tight text-ninetone-ink/70 md:text-xl">
            {heroTagline}
          </p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a href={url("/management/contact-management")} class="inline-flex items-center gap-2 bg-ninetone-ink px-4 py-3 text-sm font-semibold text-ninetone-paper transition-colors hover:bg-ninetone-ink-soft">
              {talkToUsCta} <span aria-hidden>→</span>
            </a>
            <a href="#what-we-do" class="inline-flex items-center gap-2 border border-ninetone-ink px-4 py-3 text-sm font-semibold text-ninetone-ink transition-colors hover:bg-ninetone-ink hover:text-ninetone-paper">
              {seeWhatWeDoCta} <span aria-hidden>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Positioning band -->
  <section class="border-t border-ninetone-rule bg-ninetone-paper">
    <div class="mx-auto max-w-7xl px-6 py-20 md:py-24">
      <div class="grid gap-10 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-7">
          <span class="kicker text-ninetone-ink/55">{positioningKicker}</span>
          <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">
            {positioningH2}
          </h2>
          <p class="mt-6 max-w-2xl font-display text-2xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-3xl">
            {positioningTagline}
          </p>
        </div>
        <div class="md:col-span-5 md:pt-10">
          <p class="max-w-xl text-[0.9375rem] leading-relaxed text-ninetone-ink/85">
            {positioningBody}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Three division portals — typographic with image reveal -->
  <section class="border-y border-ninetone-rule bg-ninetone-paper">
    <ul class="grid grid-cols-1 md:grid-cols-3">
      {portals.map((p, idx) => {
        const accent = sectionAccent[p.theme];
        return (
          <li class={`group relative isolate flex min-h-[320px] flex-col justify-end overflow-hidden md:min-h-[420px] ${idx > 0 ? "md:border-l border-ninetone-rule" : ""}`}>
            {/* Color overlay snaps in INSTANTLY (no transition) so text never
                sits on paper bg mid-fade. Image fades over 700ms above it. */}
            <div class={`absolute inset-0 ${accent.bg} opacity-0 group-hover:opacity-100`} aria-hidden></div>
            <div
              class="absolute inset-0 bg-cover bg-center opacity-0 mix-blend-multiply transition-opacity duration-700 ease-out group-hover:opacity-50"
              style={`background-image: ${hoverArtBackground(p.banner, url)};`}
              aria-hidden
            ></div>

            <div class="relative z-10 flex h-full flex-col justify-between gap-10 p-8 md:p-10">
              <span class={`kicker transition-colors duration-150 ease-out ${accent.text} group-hover:text-ninetone-paper/80`}>{ninetoneKicker}</span>
              <div>
                <h2 class="font-display text-5xl font-medium leading-[0.95] tracking-[-0.04em] text-ninetone-ink transition-colors duration-150 ease-out group-hover:text-ninetone-paper md:text-7xl">
                  {p.title}
                </h2>
                <p class="mt-3 max-w-md font-display text-lg italic leading-snug tracking-tight text-ninetone-ink/75 transition-colors duration-150 ease-out group-hover:text-ninetone-paper/90 md:text-xl">
                  {p.tagline}
                </p>
                <p class="mt-3 max-w-md text-sm leading-relaxed text-ninetone-ink/70 transition-colors duration-150 ease-out group-hover:text-ninetone-paper/85">
                  {p.blurb}
                </p>
                <span class="mt-6 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-ninetone-ink transition-colors duration-150 ease-out group-hover:text-ninetone-paper">
                  {enterLabel} <span aria-hidden>→</span>
                </span>
              </div>
            </div>

            <a href={url(p.href)} class="absolute inset-0 z-20" aria-label={`Ninetone ${p.title}`}></a>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- What we actually do — four-vignette editorial band -->
  <section id="what-we-do" class="bg-ninetone-paper-warm py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-10 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-7">
          <span class="kicker text-ninetone-ink/55">{howWeWorkKicker}</span>
          <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">
            {buildBridgeH2}
          </h2>
        </div>
        <div class="md:col-span-5 md:pt-2">
          <p class="font-display text-2xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-3xl">
            {howWeWorkTagline}
          </p>
        </div>
      </div>

      <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-x-16 md:gap-y-14">
        <div>
          <span class="kicker text-ninetone-ink/55">{sportKicker}</span>
          <h3 class="mt-3 font-display text-2xl leading-tight tracking-tight md:text-3xl">GIF Sundsvall</h3>
          <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-ninetone-ink/85">
            {sportBody}
          </p>
        </div>

        <div>
          <span class="kicker text-ninetone-ink/55">{orgKicker}</span>
          <h3 class="mt-3 font-display text-2xl leading-tight tracking-tight md:text-3xl">Företagarna</h3>
          <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-ninetone-ink/85">
            {orgBody}
          </p>
        </div>

        <div>
          <span class="kicker text-ninetone-ink/55">{musicKicker}</span>
          <h3 class="mt-3 font-display text-2xl leading-tight tracking-tight md:text-3xl">{musicHeading}</h3>
          <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-ninetone-ink/85">
            {musicBody}
          </p>
        </div>

        <div>
          <span class="kicker text-ninetone-ink/55">{creatorKicker}</span>
          <h3 class="mt-3 font-display text-2xl leading-tight tracking-tight md:text-3xl">{creatorHeading}</h3>
          <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-ninetone-ink/85">
            {creatorBody}
          </p>
        </div>
      </div>

      <p class="mt-20 max-w-3xl font-display text-2xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-3xl">
        {sameCoreTagline} <span class="not-italic font-medium text-ninetone-red">{sameCoreEmphasis}</span>
      </p>

      <div class="mt-12 h-px w-full bg-ninetone-ink/80" aria-hidden></div>
    </div>
  </section>

  <!-- Bento "What's on" -->
  <section class="bg-ninetone-paper py-20">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-10 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <span class="kicker text-ninetone-ink/55">{whatsOnKicker}</span>
          <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">{whatsMovingH2}</h2>
          <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-ninetone-ink/70">
            {whatsMovingBody}
          </p>
        </div>
        <span class="self-start text-xs uppercase tracking-[0.16em] text-ninetone-ink/55">{updatedWeeklyLabel}</span>
      </div>

      <BentoGrid>
        {heroArtist && (
          <BentoTile
            size="feature"
            variant="image"
            theme="records"
            href={`/records/artists/${String(heroArtist.SLUG ?? "")}`}
            image={heroArtistImage ? String(heroArtistImage) : undefined}
            imageWidth={heroArtistImageSize}
            imageHeight={heroArtistImageSize}
            kicker={artistOfWeekKicker}
            heading={heroArtistName}
            blurb={heroArtistBlurb}
            cta={viewProfileCta}
            priority
          />
        )}

        {featuredNewsItem && (
          <BentoTile
            size="wide"
            variant="image"
            theme="records"
            href={`/news/${String(featuredNewsItem.slug ?? "")}`}
            image={featuredNewsItem.image_webp ? String(featuredNewsItem.image_webp) : undefined}
            kicker={latestStoryKicker}
            heading={featuredNewsHeading}
            cta={readCta}
          />
        )}

        <BentoTile
          variant="ink"
          href="/ninetone-nation/booking"
          theme="nation"
          kicker={bookingKicker}
          heading={bookTalentHeading}
          blurb={bookTalentBlurb}
          cta={openBookingCta}
        />

        <BentoTile
          variant="warm"
          href="/records/contact-records"
          theme="records"
          kicker={demosOpenKicker}
          heading={weListenHeading}
          blurb={weListenBlurb}
          cta={submitCta}
        />

        <BentoTile
          variant="accent"
          theme="management"
          href="/management"
          kicker={managementKicker}
          heading={publicPeopleHeading}
          blurb={publicPeopleBlurb}
          cta={seeClientsCta}
        />

        {heroClient && (
          <BentoTile
            size="xwide"
            variant="image"
            theme="management"
            href={`/management/clients/${String(heroClient.SLUG ?? "")}`}
            image={heroClientImage ? String(heroClientImage) : undefined}
            imageWidth={heroClientImageSize}
            imageHeight={heroClientImageSize}
            kicker={clientInFocusKicker}
            heading={heroClientName}
            blurb={heroClientBlurb}
            cta={viewProfileCta}
          />
        )}
      </BentoGrid>
    </div>
  </section>

  <!-- Marquee artist band -->
  {marqueeNames.length > 0 && (
    <MarqueeBand items={marqueeNames} variant="ink" speed={70} />
  )}

  <!-- Roster strip -->
  {featuredArtists.length > 0 && (
    <RosterStrip
      artists={featuredArtists}
      theme="records"
      kicker={rosterKicker}
      heading={rosterHeading}
      blurb={rosterBlurb}
      cta={{ label: allArtistsCta, href: "/records/artists" }}
    />
  )}

  <!-- By the numbers -->
  <MetricsPanel
    variant="ink"
    kicker={byTheNumbersKicker}
    heading={metricsHeading}
    metrics={metrics}
  />

  <!-- Editorial news -->
  <EditorialNewsBlock
    limit={3}
    heading={editorialHeading}
    kicker={editorialKicker}
    blurb={editorialBlurb}
    href="/news"
  />

  <!-- About -->
  <section class="bg-ninetone-paper py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-4 md:sticky md:top-28 md:self-start">
        <span class="kicker text-ninetone-ink/55">{aboutKicker}</span>
        <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">Ninetone Group</h2>
      </div>
      <div class="md:col-span-8 space-y-6 max-w-2xl text-[0.9375rem] leading-relaxed text-ninetone-ink/85">
        {aboutParagraphs.map((p) => <p>{p}</p>)}
        <p class="font-display text-xl italic leading-snug tracking-tight text-ninetone-ink/85 md:text-2xl">
          {aboutClosing}
        </p>
      </div>
    </div>
  </section>

  <!-- Merch -->
  <MerchSection
    collectionId={collectionId}
    heading={merchHeading}
    kicker={merchKicker}
    blurb={merchBlurb}
    limit={10}
  />

  <!-- Talk to us — closing CTA band -->
  <section id="contact" class="bg-ninetone-ink py-24 text-ninetone-paper">
    <div class="mx-auto max-w-7xl px-6">
      <div class="grid gap-10 md:grid-cols-12 md:gap-16">
        <div class="md:col-span-7">
          <span class="kicker text-ninetone-paper/55">{closingKicker}</span>
          <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">
            {closingH2}
          </h2>
        </div>
        <div class="md:col-span-5 md:pt-2">
          <p class="max-w-xl text-[0.9375rem] leading-relaxed text-ninetone-paper/80">
            {closingBody}
          </p>
          <a
            href={url("/management/contact-management")}
            class="mt-8 inline-flex items-center gap-2 bg-ninetone-paper px-5 py-3 text-sm font-semibold text-ninetone-ink transition-colors hover:bg-ninetone-paper-warm"
          >
            {talkToUsCta} <span aria-hidden>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
