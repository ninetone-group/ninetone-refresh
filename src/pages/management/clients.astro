---
import Base from "../../layouts/Base.astro";
import ArtistCard from "../../components/ArtistCard.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import RosterFilters from "../../components/RosterFilters.astro";
import RosterIndex from "../../components/RosterIndex.astro";
import type { Artist } from "../../lib/ninetone";
import { getClients, getWebPostSection } from "../../lib/ninetone";
import { displayTitle } from "../../lib/display-title";
import { fmText, sharedT } from "../../lib/t";
// FM CONTENT (decision 8): the card blurbs are FM prose, warmed by
// scripts/translate-warm.mjs and previously rendered raw — so these listings
// stayed Swedish on /en/. Resolved here in frontmatter because fm() is async
// and the cards render inside .map().
const fm = fmText(Astro.locals);


// Core content — failures render the error page (never edge-cached) instead
// of a silently-empty client roster. Transients are absorbed by lib/cache.ts.
const clientsRaw = await getClients();
// Pre-translate the blurbs here — see the note in records/artists.astro.
//
// BOTH fields, deliberately. The cards on this page read
// `clientPresentationString`, but RosterIndex (the A–Ö index below) reads
// `artistPresentationShort` — and the object spread carries that second
// field through untranslated. Resolving only the first one and then telling
// RosterIndex `blurbsTranslated` would assert something false and leave the
// index in Swedish on /en with no visible symptom: the source text IS the
// intended render on a translation miss, so the page looks entirely healthy.
// fmText memoizes per request on the exact input, so when the two fields
// hold the same prose (the usual case) the second call is a memo hit, not a
// second KV read.
const clients = await Promise.all(
  clientsRaw.map(async (c): Promise<Artist> => ({
    ...c,
    clientPresentationString: await fm(
      String(c.clientPresentationString ?? c.artistPresentationShort ?? ""),
    ),
    artistPresentationShort: await fm(String(c.artistPresentationShort ?? "")),
  })),
);
const introBody = String((clients[0] as Record<string, unknown> | undefined)?.readMoreClients ?? "");
const webPosts = await getWebPostSection("Ninetone Management");

function tagsOf(c: Record<string, unknown>): string[] {
  const raw = (c.tags ?? c.genre ?? "") as string;
  return String(raw).split(/\r|\n|,/).map((s) => s.trim()).filter(Boolean);
}

const tagCounts = new Map<string, number>();
for (const c of clients) {
  for (const t of tagsOf(c)) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}
const sortedTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([t]) => t);

// t() bound to this request (docs/i18n-phase-2-brief.md section 4).
const t = sharedT(Astro.locals);
const clientsTitle = await t("Clients");
const description = await t(
  "The Ninetone Management roster — creators, influencers and public figures we build structure and strategy around.",
);
---

<Base
  title={clientsTitle}
  theme="management"
  description={description}
>
  <SectionIntro
    title={clientsTitle}
    tagline={displayTitle(webPosts?.title)}
    readMore={introBody}
    theme="management"
    logo="/images/managementLogo.png"
    logoAlt="Ninetone Management"
  />

  <section class="bg-ninetone-paper pb-20">
    <div class="mx-auto max-w-7xl px-6">
      <RosterFilters
        tags={sortedTags}
        theme="management"
        total={clients.length}
        showLayoutSwitch
      />

      <div
        data-roster-grid
        class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
      >
        {clients.map((c) => {
          const name = String(c["Head Artist"] ?? "");
          const tags = tagsOf(c);
          return (
            <div
              data-roster-item
              data-name={name}
              data-letter={(name[0] ?? "").toLowerCase()}
              data-tags={tags.join("|")}
            >
              <ArtistCard
                theme="management"
                name={name}
                slug={String(c.SLUG ?? "")}
                blurb={String(c.clientPresentationString ?? "")}
                image={c.artistPicture_small ? String(c.artistPicture_small) : undefined}
                imageWidth={500}
                imageHeight={500}
                tags={tags}
                highlight={String(c.highLight_client ?? "") === "true"}
                socials={{
                  instagram: c.url_instagram ? String(c.url_instagram) : undefined,
                  tiktok: c.url_tiktok_artist ? String(c.url_tiktok_artist) : undefined,
                  twitter: c.url_twitter ? String(c.url_twitter) : undefined,
                  facebook: c.url_facebook ? String(c.url_facebook) : undefined,
                  youtube: c.url_youtube_link ? String(c.url_youtube_link) : undefined,
                }}
              />
            </div>
          );
        })}
      </div>

      <RosterIndex artists={clients} hrefBase="/management/clients" blurbsTranslated />
    </div>
  </section>
</Base>
