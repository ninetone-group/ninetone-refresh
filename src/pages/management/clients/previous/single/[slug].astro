---
import Base from "../../../../../layouts/Base.astro";
import StreamingRow from "../../../../../components/StreamingRow.astro";
import MerchCard from "../../../../../components/MerchCard.astro";
import NewsCard from "../../../../../components/NewsCard.astro";
import YouTubeFeed from "../../../../../components/YouTubeFeed.astro";
import { getClients, getPreviousClients, getNewsForArtist } from "../../../../../lib/ninetone";
import { crossRosterTarget } from "../../../../../lib/roster-redirect";
import { localizedPath } from "../../../../../lib/i18n";
import { resolveChannelId, getYouTubeFeed } from "../../../../../lib/youtube";
import { getProducts } from "../../../../../lib/shopify";
import { renderBio } from "../../../../../lib/markdown";
import { urlFor } from "../../../../../lib/url";
import { pageJsonLdOrigin } from "../../../../../lib/site";
import { breadcrumbs, person, markdownToPlainText, descriptionWithBioFallback } from "../../../../../lib/schema";
import { notFound } from "../../../../../lib/not-found";
import { fmText, sharedT } from "../../../../../lib/t";

// Former Management client detail (2026-09-14) — the archive counterpart of
// src/pages/management/clients/[slug].astro, laid out like the previous-
// artist page: no "Represented by" block, no related strip. Only the record
// lookup below touches the (cron-warmed) previous-clients list.

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


export async function getStaticPaths() {
  const clients = await getPreviousClients();
  return clients
    .filter((c) => c.SLUG)
    .map((c) => ({
      params: { slug: String(c.SLUG) },
      props: { client: c },
    }));
}

// Static build (gh): client arrives via getStaticPaths props.
// Live server (cf): resolve at request time from the cached previous list.
let client = (Astro.props as { client?: Record<string, unknown> }).client;
if (!client) {
  const clients = await getPreviousClients();
  client = clients.find((c) => String(c.SLUG ?? "") === Astro.params.slug);
  if (!client) {
    // Re-signed client: the previous-client URL now belongs to the current
    // detail page (src/lib/roster-redirect.ts).
    const target = crossRosterTarget(String(Astro.params.slug ?? ""), "previous", await getClients(), "management");
    if (target) return Astro.redirect(localizedPath(target, (Astro.locals as { lang?: "sv" | "en" }).lang ?? "sv"), 301);
    return notFound(() => Astro.rewrite("/404"));
  }
}
const slug = String(client.SLUG ?? "");

const name = String(client["Head Artist"] ?? "");
// FM CONTENT (decision 8 / Definition of done). The entity's own name goes
// into `protect` so it is never "translated" into nonsense, and prose is
// translated on the `fast` tier — the same tier scripts/translate-warm.mjs
// used, so these read the already-warmed entries rather than paying again.
const fm = fmText(Astro.locals, { protect: [name] });
const tagline = await fm(String(client.clientPresentationTitle ?? ""));
const bioMarkdown = await fm(String(client.clientPresentationString ?? ""), "markdown");
const bioHtml = renderBio(bioMarkdown);

// Role-disambiguated <title> (seo-phase-1b P1 item 7) — the same person can
// exist on the Records roster too. Base's own " | Ninetone Group" suffix is
// switched off so no page ends up with two suffixes.
const pageTitle = `${name} · Previous client | Ninetone Management`;

// Item 7 description fallback: a tagline under 70 characters is too thin to
// serve as a meta description, so fall back to the opening of the bio.
const metaDescription = descriptionWithBioFallback(tagline, bioMarkdown);
const heroImage = client.artistPicture_big
  ? String(client.artistPicture_big)
  : client.artistPicture_small
  ? String(client.artistPicture_small)
  : undefined;
// worker-fm-proxy /client/:slug/big|small are verified fixed sizes
// (1000×1000 / 500×500) — track whichever field heroImage resolved to.
const heroImageSize = client.artistPicture_big ? 1000 : 500;
const tags = (client.tags
  ? String(client.tags).split(/\r|\n|,/).map((s) => s.trim()).filter(Boolean)
  : client.genre
  ? String(client.genre).split(/\r|\n|,/).map((s) => s.trim()).filter(Boolean)
  : []);
const ytOne = String(client.yotubeHighlight_one ?? "");
const ytTwo = String(client.yotubeHighlight_two ?? "");
const collectionId = String(client.collectionId ?? "").trim();

const socials = {
  spotify: client.url_spotify ? String(client.url_spotify) : undefined,
  apple: client.url_applemusic ? String(client.url_applemusic) : undefined,
  amazon: client.url_amazon ? String(client.url_amazon) : undefined,
  youtubeMusic: client.url_youtube_music ? String(client.url_youtube_music) : undefined,
  youtube: client.url_youtube_link ? String(client.url_youtube_link) : undefined,
  instagram: client.url_instagram ? String(client.url_instagram) : undefined,
  tiktok: client.url_tiktok_artist ? String(client.url_tiktok_artist) : undefined,
  twitter: client.url_twitter ? String(client.url_twitter) : undefined,
  facebook: client.url_facebook ? String(client.url_facebook) : undefined,
  soundcloud: undefined,
};

// Merch + news strip are optional embellishments — log failures, don't fail
// the page over them.
let merch: Awaited<ReturnType<typeof getProducts>> = [];
if (collectionId) {
  try { merch = await getProducts({ collectionId, limit: 8 }); } catch (err) {
    console.error(`[previous-client:${slug}] merch fetch failed:`, err);
  }
}

let latestNews: Awaited<ReturnType<typeof getNewsForArtist>> = [];
try { latestNews = await getNewsForArtist(name, 4); } catch (err) {
  console.error(`[previous-client:${slug}] news strip failed:`, err);
}
// FM CONTENT (decision 8): the "In the news" cards render FM headlines and
// excerpts. Pre-resolved here — fm() is async and these render in a .map().
latestNews = await Promise.all(
  latestNews.map(async (p) => ({
    ...p,
    Title: await fm(String(p.Title ?? "")),
    shortMessage: await fm(String(p.shortMessage ?? p.Message ?? "")),
  })),
);

const ytLinks = [ytOne, ytTwo].filter(Boolean);

// YouTube feed: latest 5 + top 5 most-viewed for clients with a usable
// channel URL. Errors out silently — section just doesn't render if the
// channel can't be resolved or the fetch fails.
const ytChannelUrl = String(client.url_youtube_link ?? "");
let ytFeed: Awaited<ReturnType<typeof getYouTubeFeed>> | null = null;
try {
  const channelId = await resolveChannelId(ytChannelUrl);
  if (channelId) ytFeed = await getYouTubeFeed(channelId);
} catch {}

const origin = pageJsonLdOrigin(Astro.request);
const jsonLd = [
  breadcrumbs(origin, [
    { name: "Management", path: "/management" },
    { name: "Previous clients", path: "/management/clients/previous" },
    { name, path: `/management/clients/previous/single/${slug}` },
  ]),
  person(origin, name, {
    role: "client",
    path: `management/clients/previous/single/${slug}`,
    image: heroImage,
    description: tagline || markdownToPlainText(String(client.clientPresentationString ?? ""), 200),
    socials,
  }),
];

// t() bound to this request (docs/i18n-phase-2-brief.md section 4). `name`/
// `tagline`/`bioHtml`/`tags` are FM-derived content, not this page's chrome.
const t = sharedT(Astro.locals);
const backToPreviousLabel = await t("← Management · Previous clients");
const archiveKicker = await t("Management — Archive");
const watchKicker = await t("Watch");
const inTheNewsKicker = await t("In the news");
const merchKicker = await t("Merch");
const officialSuffix = await t("official.");

---

<Base
  title={pageTitle}
  appendSiteName={false}
  theme="management"
  description={metaDescription || `${name} | Ninetone Management`}
  ogImage={heroImage}
  ogType="profile"
  jsonLd={jsonLd}
>
  <section class="bg-ninetone-paper">
    <div class="mx-auto max-w-7xl px-6 pb-12 pt-12 md:pt-16">
      <p class="mb-8">
        <a href={url("/management/clients/previous")} class="kicker text-ninetone-ink/55 hover:text-ninetone-ink">{backToPreviousLabel}</a>
      </p>

      <div class="grid gap-10 md:grid-cols-12 md:gap-16">
        <aside class="md:col-span-5 lg:col-span-5">
          <div class="md:sticky md:top-24">
            <div class="fm-img-frame relative aspect-[4/5] w-full overflow-hidden bg-ninetone-paper-warm">
              {heroImage && (
                <img
                  src={heroImage}
                  alt={name}
                  width={heroImageSize}
                  height={heroImageSize}
                  class="fm-img h-full w-full object-cover"
                  fetchpriority="high"
                  onload="this.classList.add('is-loaded'); this.closest('.fm-img-frame')?.classList.add('is-ready')"
                />
              )}
              <span class="absolute left-0 top-0 h-1 w-16 bg-ninetone-navy opacity-70" aria-hidden></span>
            </div>
            <div class="mt-6 hidden md:block">
              <StreamingRow socials={socials} />
            </div>
          </div>
        </aside>

        <div class="md:col-span-7 lg:col-span-7">
          <span class="kicker text-ninetone-navy">{archiveKicker}</span>
          <h1 class="mt-4 font-display text-[clamp(3rem,8vw,7rem)] leading-[0.9] tracking-[-0.045em]">{name}</h1>

          {tagline && (
            <p class="mt-6 max-w-xl font-display text-2xl italic leading-snug tracking-tight text-ninetone-ink/75 md:text-3xl">
              {tagline}
            </p>
          )}

          {tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-xs uppercase tracking-[0.16em] text-ninetone-ink/60">
              {tags.slice(0, 6).map((g, i) => (
                <span>{i > 0 && <span aria-hidden class="mr-4 opacity-40">·</span>}{g}</span>
              ))}
            </div>
          )}

          <div class="mt-8 md:hidden">
            <StreamingRow socials={socials} />
          </div>

          {bioHtml && <div class="mt-12 prose lede max-w-none" set:html={bioHtml}></div>}

          {ytLinks.length > 0 && (
            <div class="mt-16 border-t border-ninetone-rule pt-10">
              <span class="kicker text-ninetone-ink/55">{watchKicker}</span>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {ytLinks.map((url) => {
                  const idMatch = url.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/);
                  const id = idMatch ? idMatch[1] : null;
                  return id ? (
                    <iframe src={`https://www.youtube.com/embed/${id}`} class="aspect-video w-full" title={`${name} video`} loading="lazy" allowfullscreen></iframe>
                  ) : null;
                })}
              </div>
            </div>
          )}

          {latestNews.length > 0 && (
            <div class="mt-16 border-t border-ninetone-rule pt-10">
              <span class="kicker text-ninetone-ink/55">{inTheNewsKicker}</span>
              <ul class="mt-6 grid gap-x-8 gap-y-10 md:grid-cols-2">
                {latestNews.map((p) => (
                  <li>
                    <NewsCard
                      title={String(p.Title ?? "")}
                      slug={String(p.slug ?? "")}
                      image={p.image_webp ? String(p.image_webp) : undefined}
                      date={String(p.Date ?? "")}
                      category={String(p.category ?? "")}
                      hasVideo={["ytLinkA","ytLinkB","ytLinkC","ytLinkD"].some((k) => typeof (p as Record<string, unknown>)[k] === "string" && ((p as Record<string, unknown>)[k] as string).trim().length > 0)}
                      size="sm"
                    />
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <YouTubeFeed feed={ytFeed} clientName={name} theme="management" />

  {merch.length > 0 && (
    <section class="bg-ninetone-paper-warm py-20">
      <div class="mx-auto max-w-7xl px-6">
        <div class="mb-10">
          <span class="kicker text-ninetone-navy">{merchKicker}</span>
          <h2 class="mt-3 font-display text-4xl leading-[1.05] tracking-tight md:text-5xl">{name} — {officialSuffix}</h2>
        </div>
        <div class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:grid-cols-4">
          {merch.map((p) => <MerchCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>
