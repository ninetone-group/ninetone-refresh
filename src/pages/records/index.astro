---
import Base from "../../layouts/Base.astro";
import SplitPortalHero from "../../components/SplitPortalHero.astro";
import WebPostsSection from "../../components/WebPostsSection.astro";
import MerchSection from "../../components/MerchSection.astro";
import LatestNewsSection from "../../components/LatestNewsSection.astro";
import { getWebPostSection } from "../../lib/ninetone";
import { sharedT } from "../../lib/t";

const webPosts = await getWebPostSection("Ninetone Records");

// t() bound to this request (docs/i18n-phase-2-brief.md section 4). "Ninetone
// Records" is a proper noun (brand name) — NOT translated, per rule 3.
const t = sharedT(Astro.locals);
const description = await t(
  "Ninetone Records: A&R, production and artist development from song to universe. Meet the roster and the team shaping Sweden's sound.",
);
const artistsLabel = await t("Artists");
const artistsBlurb = await t("The roster — active and shaping the sound of Sweden right now.");
const theTeamLabel = await t("The team");
const theTeamBlurb = await t("A&R, production, marketing — the people you'll actually work with.");
const shopKicker = await t("Records — Shop");
const shopHeading = await t("CDs and music.");
const shopBlurb = await t("Catalogue and recent releases — direct from our shop.");
---

<Base
  title="Ninetone Records"
  theme="records"
  description={description}
>
  {/* Page-level H1. Visually hidden because this archetype's identity is
      carried by the portal tiles and the kicker, and DESIGN.md fixes that
      treatment — but the page still needs exactly one heading that names it,
      and it must belong to the PAGE, not to whichever tile happens to render
      first inside a shared component. */}
  <h1 class="sr-only">Ninetone Records</h1>

  <SplitPortalHero
    theme="records"
    kicker="Ninetone Records"
    left={{
      href: "/records/artists",
      label: artistsLabel,
      blurb: artistsBlurb,
      bgImage: "/images/artistSectionBanner.png",
    }}
    right={{
      href: "/team",
      label: theTeamLabel,
      blurb: theTeamBlurb,
      bgImage: "/images/meetTheTeamBanner.png",
    }}
  />
  <WebPostsSection data={webPosts} />
  <MerchSection
    collectionId="515486843145"
    kicker={shopKicker}
    heading={shopHeading}
    blurb={shopBlurb}
    limit={10}
  />
  <LatestNewsSection />
</Base>
