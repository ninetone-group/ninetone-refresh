---
import Base from "../layouts/Base.astro";
import { urlFor } from "../lib/url";
import { sharedT } from "../lib/t";

// Locale-bound link builder (i18n Phase 2): every internal href on an
// English page must keep the /en prefix, or one click drops the visitor
// back to Swedish. Shadows the plain url() import for this component.
const url = urlFor(Astro.locals);


// t() bound to this request (docs/i18n-phase-2-brief.md section 4). The
// <script> below runs client-side after hydration and cannot call t()
// itself (async, needs Astro.locals) — every string it needs is resolved
// here and threaded through as data-i18n-* attributes on #search-root
// (the bridge pattern from SectionIntro.astro / note 4), rather than left
// hardcoded in English as CommandPalette.astro's SECTION_LABELS currently is.
const t = sharedT(Astro.locals);
const pageTitle = await t("Search");
const searchKicker = await t("Search");
const findAnythingHeading = await t("Find anything.");
const cmdkHintPrefix = await t("Press");
const cmdkHintSuffix = await t("from anywhere on the site to open the command palette.");
const searchPlaceholder = await t("Search artists, news, team…");
const searchButtonLabel = await t("Search");
const typeAQueryLabel = await t("Type a query and press search.");
const searchingLabel = await t("Searching…");
const noResultsForLabel = await t("No results for");
const resultLabel = await t("result");
const resultsLabel = await t("results");
const forLabel = await t("for");
const sectionLabelsSource: Record<string, string> = {
  records: "Records",
  previous: "Previous artists",
  management: "Management",
  nation: "Nation",
  team: "Team",
  news: "News",
};
const sectionLabels = Object.fromEntries(
  await Promise.all(Object.entries(sectionLabelsSource).map(async ([k, v]) => [k, await t(v)] as const)),
);

---

<Base
  title={pageTitle}
  {/* Internal search is a crawl-efficiency sink: an unbounded query space
      with no standalone value. It is excluded from the sitemap, but omission
      alone does not prevent discovery, and today it is protected only by the
      temporary staging-wide noindex — so it would become indexable the moment
      that is lifted at launch. Page-level and permanent (SEO audit P2). */}
  noindex
>
  <section class="bg-ninetone-paper">
    <div class="mx-auto max-w-7xl px-6 pb-12 pt-16 md:pt-24">
      <span class="kicker text-ninetone-ink/55">{searchKicker}</span>
      <h1 class="mt-4 font-display text-[clamp(2.75rem,7vw,6rem)] leading-[0.95] tracking-[-0.035em]">
        {findAnythingHeading}
      </h1>
      <p class="mt-4 max-w-xl text-base text-ninetone-ink/65">
        {cmdkHintPrefix} <kbd class="rounded border border-ninetone-ink/15 px-1.5 py-0.5 text-xs font-medium text-ninetone-ink/70">⌘K</kbd> {cmdkHintSuffix}
      </p>

      <form method="get" action={url("/search-result")} class="mt-10 flex max-w-2xl items-center gap-3 border-b border-ninetone-ink/20 pb-3">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-ninetone-ink/55">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="search-input"
          type="search"
          name="q"
          placeholder={searchPlaceholder}
          class="w-full border-0 bg-transparent font-display text-2xl text-ninetone-ink placeholder-ninetone-ink/35 focus:outline-none"
          autocomplete="off"
        />
        <button type="submit" class="bg-ninetone-ink px-4 py-2 text-sm font-semibold text-ninetone-paper transition-colors hover:bg-ninetone-ink-soft">
          {searchButtonLabel}
        </button>
      </form>
      <p id="search-status" class="mt-4 text-xs uppercase tracking-[0.16em] text-ninetone-ink/55">{typeAQueryLabel}</p>
    </div>
  </section>

  <section class="bg-ninetone-paper pb-24">
    <div
      id="search-root"
      data-i18n-type-a-query={typeAQueryLabel}
      data-i18n-searching={searchingLabel}
      data-i18n-no-results-for={noResultsForLabel}
      data-i18n-result={resultLabel}
      data-i18n-results={resultsLabel}
      data-i18n-for={forLabel}
      data-i18n-section-labels={JSON.stringify(sectionLabels)}
    >
      <div id="search-results" class="mx-auto max-w-7xl px-6"></div>
    </div>
  </section>
</Base>

<script>
  import Fuse from "fuse.js";

  type SearchSection = "records" | "previous" | "management" | "nation" | "team" | "news";
  type SearchEntry = {
    section: SearchSection;
    name: string;
    blurb: string;
    tags: string[];
    href: string;
    image?: string;
  };

  // Bridge pattern (docs/i18n-phase-2-brief.md section 4, note 4): this
  // <script> runs client-side with no Astro.locals, so it cannot call t()
  // itself. Every string it needs was resolved server-side in the
  // frontmatter above and threaded through as data-i18n-* attributes on
  // #search-root — read once here rather than re-authored in English inline
  // (the gap CommandPalette.astro's SECTION_LABELS documents but leaves
  // open; fixed here since this page's script only needed a plain JSON
  // object, not the more involved dynamic-list shape CommandPalette has).
  const root = document.getElementById("search-root");
  const i18n = {
    typeAQuery: root?.dataset.i18nTypeAQuery || "Type a query and press search.",
    searching: root?.dataset.i18nSearching || "Searching…",
    noResultsFor: root?.dataset.i18nNoResultsFor || "No results for",
    result: root?.dataset.i18nResult || "result",
    results: root?.dataset.i18nResults || "results",
    for: root?.dataset.i18nFor || "for",
  };
  const SECTION_LABELS: Record<SearchSection, string> = root?.dataset.i18nSectionLabels
    ? JSON.parse(root.dataset.i18nSectionLabels)
    : {
        records: "Records",
        previous: "Previous artists",
        management: "Management",
        nation: "Nation",
        team: "Team",
        news: "News",
      };

  const SECTION_ORDER: SearchSection[] = ["records", "management", "nation", "previous", "team", "news"];

  let indexPromise: Promise<SearchEntry[]> | null = null;
  function loadIndex(): Promise<SearchEntry[]> {
    if (!indexPromise) {
      const base = import.meta.env.BASE_URL.replace(/\/$/, "");
      indexPromise = fetch(`${base}/search-index.json`).then((r) => r.json());
    }
    return indexPromise;
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function safeInternalUrl(value: string): string {
    try {
      const parsed = new URL(value, window.location.origin);
      const internal = parsed.origin === window.location.origin ? parsed.pathname + parsed.search + parsed.hash : "#";
      return localizeInternal(internal);
    } catch { return "#"; }
  }

  // LOCALE-PRESERVING (translations audit P1) — see the fuller note in
  // CommandPalette.astro. /search-index.json is a single locale-neutral
  // document whose hrefs are bare Swedish paths; without this an English
  // visitor clicking a search result lands on the Swedish page. Derived from
  // the current URL rather than threaded as data, so the shared index stays
  // one cacheable document instead of one per locale.
  function currentLocalePrefix(): string {
    return /^\/en(\/|$)/.test(window.location.pathname) ? "/en" : "";
  }

  function localizeInternal(path: string): string {
    if (!path || path === "#" || path.startsWith("#")) return path;
    const prefix = currentLocalePrefix();
    if (!prefix) return path;
    return /^\/en(\/|$)/.test(path) ? path : prefix + path;
  }

  function safeImageUrl(value: string): string {
    try {
      const parsed = new URL(value, window.location.origin);
      return ["http:", "https:"].includes(parsed.protocol) ? parsed.href : "";
    } catch { return ""; }
  }

  function renderResults(query: string, hits: SearchEntry[]): string {
    if (hits.length === 0) {
      return `<p class="text-base text-ninetone-ink/65">${i18n.noResultsFor} <strong>${escapeHtml(query)}</strong>.</p>`;
    }

    const grouped = new Map<SearchSection, SearchEntry[]>();
    for (const h of hits) {
      const arr = grouped.get(h.section) ?? [];
      arr.push(h);
      grouped.set(h.section, arr);
    }

    const sections = SECTION_ORDER.filter((s) => grouped.has(s));
    return sections
      .map((s) => {
        const items = grouped.get(s)!;
        const cards = items
          .map(
            (e) => `
              <a href="${escapeHtml(safeInternalUrl(e.href))}" class="group flex flex-col gap-3 border-t border-ninetone-rule pt-4 transition-colors">
                ${e.image && safeImageUrl(e.image) ? `<div class="aspect-[4/3] w-full overflow-hidden bg-ninetone-paper-warm"><img src="${escapeHtml(safeImageUrl(e.image))}" alt="" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]" loading="lazy" /></div>` : ""}
                <div>
                  <h3 class="font-display text-xl font-medium leading-tight tracking-tight transition-colors group-hover:opacity-70">${escapeHtml(e.name)}</h3>
                  ${e.blurb ? `<p class="mt-2 line-clamp-2 text-sm text-ninetone-ink/65">${escapeHtml(e.blurb)}</p>` : ""}
                  ${e.tags.length ? `<div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[0.6875rem] uppercase tracking-[0.12em] text-ninetone-ink/55">${e.tags.slice(0, 3).map((t, i) => `${i > 0 ? '<span class="opacity-40">·</span>' : ""}<span>${escapeHtml(t)}</span>`).join("")}</div>` : ""}
                </div>
              </a>`,
          )
          .join("");
        return `
          <div class="mb-12">
            <div class="mb-6 flex items-center justify-between">
              <span class="kicker text-ninetone-ink/55">${SECTION_LABELS[s]}</span>
              <span class="text-xs text-ninetone-ink/55">${items.length}</span>
            </div>
            <div class="grid gap-x-8 gap-y-12 md:grid-cols-3 lg:grid-cols-4">${cards}</div>
          </div>`;
      })
      .join("");
  }

  async function runSearch(query: string) {
    const status = document.getElementById("search-status");
    const out = document.getElementById("search-results");
    if (!status || !out) return;

    if (!query) {
      status.textContent = i18n.typeAQuery;
      out.innerHTML = "";
      return;
    }

    status.textContent = i18n.searching;
    out.innerHTML = "";

    const data = await loadIndex();
    const fuse = new Fuse(data, {
      keys: [
        { name: "name", weight: 0.6 },
        { name: "blurb", weight: 0.25 },
        { name: "tags", weight: 0.15 },
      ],
      threshold: 0.35,
      ignoreLocation: true,
      minMatchCharLength: 2,
    });

    const results = fuse.search(query, { limit: 100 }).map((r) => r.item);
    const countLabel = results.length === 1 ? i18n.result : i18n.results;
    status.textContent = `${results.length} ${countLabel} ${i18n.for} "${query}"`;
    out.innerHTML = renderResults(query, results);
  }

  const params = new URLSearchParams(window.location.search);
  const initialQuery = params.get("q")?.trim() ?? "";
  const input = document.getElementById("search-input") as HTMLInputElement | null;
  if (input && initialQuery) input.value = initialQuery;
  if (initialQuery) runSearch(initialQuery);
</script>
